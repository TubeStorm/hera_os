</style>

<script>
  const section = document.querySelector('#problem-finding-story');
  const stage = section?.querySelector('[data-problem-stage]');
  const steps = Array.from(section?.querySelectorAll('[data-problem-step]') ?? []);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && stage && steps.length) {
    let activeIndex = -1;
    let ticking = false;

    const setState = (index) => {
      const safeIndex = Math.max(0, Math.min(steps.length - 1, index));
      if (safeIndex === activeIndex) return;

      activeIndex = safeIndex;
      stage.setAttribute('data-state', String(safeIndex));

      steps.forEach((step, stepIndex) => {
        step.classList.toggle('is-active', stepIndex === safeIndex);
        step.setAttribute('aria-current', stepIndex === safeIndex ? 'step' : 'false');
      });
    };

    const updateFromScroll = () => {
      ticking = false;
      const readingLine = window.innerHeight * 0.46;
      let bestIndex = 0;
      let bestDistance = Number.POSITIVE_INFINITY;

      steps.forEach((step, index) => {
        const rect = step.getBoundingClientRect();
        const stepFocus = rect.top + Math.min(rect.height * 0.42, 250);
        const distance = Math.abs(stepFocus - readingLine);

        if (distance < bestDistance) {
          bestDistance = distance;
          bestIndex = index;
        }
      });

      setState(bestIndex);
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateFromScroll);
    };

    if (reducedMotion) {
      setState(0);
    } else {
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });
      updateFromScroll();
    }
  }
</script>
