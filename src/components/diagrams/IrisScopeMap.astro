---
// Separating global assistant behavior from room-scoped work.
// Left: Global Iris travels with the user. Right: rooms hold scoped work.
---

<div class="grid gap-4 sm:grid-cols-[0.9fr_auto_1.1fr] sm:items-stretch">
  <!-- Global -->
  <div class="flex flex-col rounded-2xl border border-line bg-[color:var(--surface)] p-4" style="box-shadow: var(--shadow-card);">
    <div class="flex items-center gap-2">
      <span class="grid h-6 w-6 place-items-center rounded-md bg-ink text-[11px] font-bold text-paper">I</span>
      <span class="text-sm font-semibold tracking-tight">Global Iris</span>
    </div>
    <p class="mt-2 text-xs leading-relaxed text-muted">One identity that follows you across the OS: never hijacks the workspace.</p>
    <ul class="mt-3 space-y-1.5 text-[11px] text-faint">
      <li>· right-rail, always reachable</li>
      <li>· cross-room awareness</li>
      <li>· your preferences, everywhere</li>
    </ul>
  </div>

  <!-- connector -->
  <div class="hidden items-center justify-center sm:flex" aria-hidden="true">
    <svg width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="var(--faint)" stroke-width="1.5">
      <path d="M2 12h30M28 6l6 6-6 6" />
    </svg>
  </div>

  <!-- Rooms -->
  <div class="rounded-2xl border border-line bg-[color:var(--surface)] p-4" style="box-shadow: var(--shadow-card);">
    <p class="text-sm font-semibold tracking-tight">Rooms / workspaces</p>
    <p class="mt-2 text-xs leading-relaxed text-muted">Scoped spaces where work, files, and agents live together with clear boundaries.</p>
    <div class="mt-3 grid grid-cols-3 gap-2">
      {['Research', 'Build', 'Ops'].map((r, i) => (
        <div class:list={['rounded-lg border border-line px-2 py-2 text-center', i === 1 ? 'bg-[color:var(--accent-soft)]' : 'bg-[color:var(--paper)]']}>
          <p class="text-[11px] font-medium text-ink">{r}</p>
          <p class="mt-0.5 text-[10px] text-faint">room {i + 1}</p>
        </div>
      ))}
    </div>
    <p class="mt-3 text-[11px] text-faint">Same assistant, different context: no confusion about where work lives.</p>
  </div>
</div>
