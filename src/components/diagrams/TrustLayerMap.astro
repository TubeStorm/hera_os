---
// HERA flagship visual: the "trust layer": the AI reporting its own state so
// nothing important is invisible. Global Iris frame + five visible-state chips:
// what the AI saw, did, saved, (never) forgot, and what it cost.
const states = [
  { k: 'Saw', v: '3 files in room', d: 'file-aware chat' },
  { k: 'Did', v: '2 actions · reversible', d: 'surface actions' },
  { k: 'Saved', v: '1 memory block', d: 'human-readable' },
  { k: 'Forgot', v: 'nothing hidden', d: 'no ghost state' },
  { k: 'Cost', v: '$0.04 this turn', d: 'visible burn' },
];
---

<div class="mx-auto w-full max-w-xl">
  <!-- window frame -->
  <div class="overflow-hidden rounded-2xl border border-line bg-[color:var(--surface)]" style="box-shadow: var(--shadow-card);">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <span class="grid h-6 w-6 place-items-center rounded-md bg-ink text-[11px] font-bold text-paper">I</span>
      <span class="text-sm font-semibold tracking-tight">Global Iris</span>
      <span class="ml-auto inline-flex items-center gap-1.5 rounded-pill border border-line px-2 py-0.5 text-[11px] font-medium text-muted">
        <span class="h-1.5 w-1.5 rounded-full" style="background: var(--accent)"></span>
        watching the whole OS
      </span>
    </div>
    <div class="p-4">
      <p class="text-xs uppercase tracking-[0.12em] text-faint">What the system will tell you every turn</p>
      <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {states.map((s) => (
          <div class="flex items-center justify-between gap-3 rounded-xl border border-line bg-[color:var(--paper)] px-3.5 py-2.5">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em]" style="color: var(--accent)">{s.k}</p>
              <p class="mt-0.5 text-sm font-medium text-ink">{s.v}</p>
            </div>
            <span class="text-[11px] text-faint">{s.d}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
