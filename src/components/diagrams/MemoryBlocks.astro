---
// Memory blocks: human-readable memory the user can see, edit, and trust,
// instead of an opaque black box.
const blocks = [
  { t: 'Preference', b: 'Ship copy in a direct, no-fluff voice.' },
  { t: 'Project', b: 'HERA closeout docs live under docs/closeout/.' },
  { t: 'Fact', b: 'Backend restarts itself: just kill the process.' },
];
---

<div class="mx-auto w-full max-w-lg">
  <div class="rounded-2xl border border-line bg-[color:var(--surface)] p-4" style="box-shadow: var(--shadow-card);">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold tracking-tight">Memory</p>
      <span class="text-[11px] text-faint">visible · editable · yours</span>
    </div>
    <div class="mt-3 space-y-2">
      {blocks.map((m) => (
        <div class="flex items-start gap-3 rounded-xl border border-line bg-[color:var(--paper)] px-3.5 py-2.5">
          <span class="mt-0.5 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.08em]" style="color: var(--accent); background: var(--accent-soft)">{m.t}</span>
          <p class="text-sm text-ink">{m.b}</p>
          <span class="ml-auto shrink-0 text-faint" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
          </span>
        </div>
      ))}
    </div>
    <p class="mt-3 text-[11px] text-faint">Not a hidden vector store: memory you can read, correct, or delete.</p>
  </div>
</div>
