---
// Enterprise systemization: 40+ inconsistent one-off modals (before) collapse
// into one coherent, reusable pattern (after).
---

<div class="grid gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-center">
  <!-- Before: scattered, mismatched -->
  <div class="rounded-2xl border border-line bg-[color:var(--surface)] p-4">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-faint">Before: 40+ one-off modals</p>
    <div class="mt-3 grid grid-cols-4 gap-1.5" aria-hidden="true">
      {Array.from({ length: 20 }).map((_, i) => (
        <div
          class="rounded-[5px] border border-line bg-[color:var(--paper)]"
          style={`height:${16 + (i % 4) * 6}px; opacity:${0.55 + (i % 3) * 0.15}; transform: rotate(${((i % 5) - 2) * 1.4}deg);`}
        ></div>
      ))}
    </div>
    <p class="mt-3 text-[11px] text-faint">Inconsistent approvals, buried quotas, rules that read differently everywhere.</p>
  </div>

  <!-- arrow -->
  <div class="flex items-center justify-center" aria-hidden="true">
    <svg width="36" height="24" viewBox="0 0 36 24" fill="none" stroke="var(--faint)" stroke-width="1.5" class="rotate-90 sm:rotate-0">
      <path d="M2 12h28M26 6l6 6-6 6" />
    </svg>
  </div>

  <!-- After: one system -->
  <div class="rounded-2xl border p-4" style="border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); background: var(--surface); box-shadow: var(--shadow-card);">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em]" style="color: var(--accent)">After: one coherent pattern</p>
    <div class="mt-3 rounded-xl border border-line bg-[color:var(--paper)] p-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-ink">Approval</span>
        <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold" style="color: var(--accent); background: var(--accent-soft)">consistent</span>
      </div>
      <div class="mt-2 space-y-1.5">
        <div class="h-2 w-full rounded-full bg-[color:var(--line)]"></div>
        <div class="h-2 w-4/5 rounded-full bg-[color:var(--line)]"></div>
        <div class="h-2 w-3/5 rounded-full bg-[color:var(--line)]"></div>
      </div>
    </div>
    <p class="mt-3 text-[11px] text-faint">Same status, ownership, and next steps: everywhere they appear.</p>
  </div>
</div>
