---
// Permission / run-confirm model — protect the user without interrupting flow.
const steps = [
  { t: 'Agent requests', d: 'wants to run “delete 4 files”' },
  { t: 'Run-confirm', d: 'shows exactly what & where' },
  { t: 'Allow / Deny', d: 'or “always allow” safe tools' },
];
---

<div class="w-full">
  <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
    {steps.map((s, i) => (
      <Fragment>
        <div class="flex-1 rounded-2xl border border-line bg-[color:var(--surface)] p-3.5" style="box-shadow: var(--shadow-card);">
          <p class="text-[11px] font-semibold uppercase tracking-[0.1em]" style="color: var(--accent)">{String(i + 1).padStart(2, '0')}</p>
          <p class="mt-1 text-sm font-medium text-ink">{s.t}</p>
          <p class="mt-0.5 text-[11px] text-faint">{s.d}</p>
        </div>
        {i < steps.length - 1 && (
          <span class="hidden shrink-0 text-faint sm:block" aria-hidden="true">
            <svg width="22" height="16" viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 8h16M13 3l5 5-5 5" /></svg>
          </span>
        )}
      </Fragment>
    ))}
  </div>
  <div class="mt-3 flex items-center gap-3 rounded-xl border border-line bg-[color:var(--paper)] px-3.5 py-2.5">
    <span class="text-[11px] text-faint">System tools stay frictionless:</span>
    <span class="rounded-pill border border-line px-2 py-0.5 text-[11px] text-muted">read files</span>
    <span class="rounded-pill border border-line px-2 py-0.5 text-[11px] text-muted">search</span>
    <span class="ml-auto text-[11px] font-medium" style="color: var(--accent)">auto-allowed</span>
  </div>
</div>
