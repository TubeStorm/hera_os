---
// The core agentic-UX failure and the fix: a chat turn that appears stuck /
// half-finished / silently failed (before) vs. a visible, honest system state (after).
---

<div class="grid gap-4 sm:grid-cols-2">
  <!-- Before -->
  <div class="rounded-2xl border border-line bg-[color:var(--surface)] p-4">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-faint">Before — ghost state</p>
    <div class="mt-3 space-y-2">
      <div class="rounded-xl border border-line bg-[color:var(--paper)] px-3 py-2 text-sm text-muted">Run the report agent.</div>
      <div class="rounded-xl border border-dashed border-line px-3 py-4 text-center">
        <span class="inline-flex items-center gap-2 text-[11px] text-faint">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[color:var(--faint)]"></span>
          …nothing. Did it work? Did it save? Did it cost money?
        </span>
      </div>
    </div>
    <p class="mt-3 text-[11px] text-faint">Empty turns, duplicate replies, fake success — trust leaks here.</p>
  </div>

  <!-- After -->
  <div class="rounded-2xl border p-4" style="border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); background: var(--surface); box-shadow: var(--shadow-card);">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em]" style="color: var(--accent)">After — visible state</p>
    <div class="mt-3 space-y-2">
      <div class="rounded-xl border border-line bg-[color:var(--paper)] px-3 py-2 text-sm text-muted">Run the report agent.</div>
      <div class="rounded-xl border border-line bg-[color:var(--paper)] px-3 py-2.5">
        <p class="flex items-center gap-2 text-sm font-medium text-ink">
          <span class="inline-flex h-4 w-4 items-center justify-center rounded-full" style="color: var(--accent); background: var(--accent-soft)">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          Report generated
        </p>
        <p class="mt-1 text-[11px] text-faint">2 files read · saved to Files · $0.03 · undo available</p>
      </div>
    </div>
    <p class="mt-3 text-[11px] text-faint">Cause, effect, cost, and a way back — every time.</p>
  </div>
</div>
