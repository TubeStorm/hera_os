---
// Enterprise approval flow made traceable — clear status, owner, and next step.
const stages = [
  { t: 'Submitted', who: 'Producer', state: 'done' },
  { t: 'In review', who: 'Team lead', state: 'active' },
  { t: 'Approved', who: 'Ops', state: 'pending' },
];
---

<div class="w-full">
  <div class="flex flex-col items-stretch gap-2.5 sm:flex-row sm:items-center">
    {stages.map((s, i) => (
      <Fragment>
        <div
          class="flex-1 rounded-2xl border bg-[color:var(--surface)] p-3.5"
          style={s.state === 'active'
            ? 'border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); box-shadow: var(--shadow-card);'
            : 'border-color: var(--line);'}
        >
          <div class="flex items-center gap-2">
            <span
              class="grid h-4 w-4 place-items-center rounded-full text-paper"
              style={s.state === 'pending' ? 'background: var(--faint)' : 'background: var(--accent)'}
              aria-hidden="true"
            >
              {s.state !== 'pending' && (
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" /></svg>
              )}
            </span>
            <p class="text-sm font-medium text-ink">{s.t}</p>
          </div>
          <p class="mt-1 pl-6 text-[11px] text-faint">owner · {s.who}</p>
        </div>
        {i < stages.length - 1 && (
          <span class="hidden shrink-0 text-faint sm:block" aria-hidden="true">
            <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 7h14M11 2l5 5-5 5" /></svg>
          </span>
        )}
      </Fragment>
    ))}
  </div>
  <p class="mt-3 text-[11px] text-faint">Every approval shows where it is, who owns it, and what happens next — no black-box sign-off.</p>
</div>
