---
// One project on the Lineage page.
//   featured → gets the [>] expander revealing the extra panels
//   regular  → same block, no expander
// Media comes from src/data/lineage.ts: video, image, or an honest blank.
import MediaFrame from './MediaFrame.astro';
import type { LineageProject } from '../data/lineage';

interface Props {
  project: LineageProject;
}
const { project: p } = Astro.props;
const expandable = p.tier === 'featured' && p.more && p.more.length > 0;
---

<article class="reveal" id={p.id}>
  <div class="flex items-center gap-4">
    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-ink text-lg font-bold tracking-tight text-paper">
      {p.mark}
    </span>
    <h2 class="text-h2 font-semibold tracking-tight">{p.title}</h2>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
    <span class="uppercase tracking-[0.12em] text-faint">{p.thread}</span>
    <span aria-hidden="true">·</span>
    <span>{p.date}</span>
    <span aria-hidden="true">·</span>
    <span>{p.meta}</span>
    {
      expandable && (
        <button
          class="lineage-toggle ml-auto grid h-8 w-8 place-items-center rounded-pill border border-line text-muted transition duration-300 hover:border-ink hover:text-ink"
          aria-expanded="false"
          aria-label={`More about ${p.title}`}
        >
          <span class="inline-block transition-transform duration-300">›</span>
        </button>
      )
    }
  </div>

  <div class="mt-6 grid gap-x-10 gap-y-4 sm:grid-cols-2">
    <p class="text-sm leading-relaxed text-muted"><span class="mr-2 text-faint">the problem</span>{p.problem}</p>
    <p class="text-sm leading-relaxed text-muted"><span class="mr-2 text-faint">what I rejected</span>{p.rejected}</p>
    <p class="text-sm leading-relaxed text-muted"><span class="mr-2 text-faint">what I built</span>{p.built}</p>
    <p class="text-sm leading-relaxed text-muted"><span class="mr-2 text-faint">what HERA inherited</span>{p.inherited}</p>
  </div>

  {
    expandable && (
      <div class="lineage-more mt-6 hidden gap-4 overflow-x-auto pb-2 sm:grid-cols-3">
        {p.more!.map((panel) => (
          <div class="min-w-[16rem] rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-semibold text-ink">{panel.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{panel.body}</p>
          </div>
        ))}
      </div>
    )
  }

  <MediaFrame video={p.video} image={p.image} missing={p.missing} caption={p.video || p.image ? `${p.title}: ${p.status}` : undefined} class="mt-6" />
  <p class="mt-3 text-xs text-faint">{p.status}</p>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.lineage-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const article = btn.closest('article');
      const panel = article?.querySelector('.lineage-more');
      if (!panel) return;
      const open = panel.classList.toggle('hidden') === false;
      panel.classList.toggle('sm:grid', open);
      panel.classList.toggle('flex', open);
      btn.setAttribute('aria-expanded', String(open));
      const chevron = btn.querySelector('span');
      if (chevron) chevron.style.transform = open ? 'rotate(90deg)' : '';
    });
  });
</script>
