---
interface Props {
  label: string;
  ratio?: 'wide' | 'video' | 'square' | 'tall';
  class?: string;
}
const { label, ratio = 'video', class: cls = '' } = Astro.props;
const ratioClass = {
  wide: 'aspect-[16/7]',
  video: 'aspect-[16/9]',
  square: 'aspect-square',
  tall: 'aspect-[4/5]',
}[ratio];
---

<div
  class:list={[
    'group relative flex w-full items-center justify-center overflow-hidden rounded-card border border-line',
    ratioClass,
    cls,
  ]}
  style="background:
    radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--accent) 8%, var(--surface)) 0%, var(--surface) 55%);"
  role="img"
  aria-label={`Screenshot placeholder — ${label}`}
>
  <!-- fine dot-grid texture -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.5]"
    style="background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 22px 22px;"
  >
  </div>
  <div class="relative flex flex-col items-center gap-2 px-6 text-center">
    <span class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-[color:var(--paper)] text-faint">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="3" y="4" width="18" height="14" rx="2" />
        <path d="m3 15 4-4 4 4 3-3 4 4" />
        <circle cx="8.5" cy="9" r="1.2" />
      </svg>
    </span>
    <span class="text-xs font-medium uppercase tracking-[0.12em] text-faint">Screenshot placeholder</span>
    <span class="text-sm text-muted">{label}</span>
  </div>
</div>
