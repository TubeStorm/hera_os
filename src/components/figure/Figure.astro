---
// Framed container for designed editorial visuals (system diagrams, annotated
// UI cards, before/after maps). Replaces the old "Screenshot placeholder" chrome
// with a real caption + a subtle "Diagram" tag. Content goes in the default slot.
interface Props {
  label: string; // caption under the figure
  tag?: string; // small pill, e.g. "System map", "Before / after"
  ratio?: 'wide' | 'video' | 'tall' | 'auto';
  class?: string;
}
const { label, tag = 'Diagram', ratio = 'auto', class: cls = '' } = Astro.props;
const minH = {
  wide: 'min-h-[220px] sm:min-h-[300px]',
  video: 'min-h-[240px] sm:min-h-[320px]',
  tall: 'min-h-[360px] sm:min-h-[460px]',
  auto: '',
}[ratio];
---

<figure class:list={['not-prose', cls]}>
  <div
    class:list={[
      'relative overflow-hidden rounded-card border border-line',
      minH,
    ]}
    style="background:
      radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--accent) 6%, var(--surface)) 0%, var(--surface) 60%);"
  >
    <!-- fine dot-grid texture, very restrained -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.35]"
      style="background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 24px 24px;"
      aria-hidden="true"
    >
    </div>
    <div class="relative p-5 sm:p-7">
      <slot />
    </div>
  </div>
  <figcaption class="mt-3 flex items-center gap-2 text-xs text-faint">
    <span class="inline-flex items-center gap-1.5 rounded-pill border border-line px-2 py-0.5 font-medium uppercase tracking-[0.1em] text-muted">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5" />
        <rect x="14" y="3" width="7" height="7" rx="1.5" />
        <rect x="3" y="14" width="7" height="7" rx="1.5" />
        <path d="M17.5 14v7M14 17.5h7" />
      </svg>
      {tag}
    </span>
    <span>{label}</span>
  </figcaption>
</figure>
