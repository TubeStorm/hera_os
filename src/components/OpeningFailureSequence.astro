---
// Homepage opening: a scroll-scrubbed cinematic. Scroll progress (0 -> 1 across a
// tall pinned track) is the ONLY clock: there is no autoplay and no timer.
//
// Re-authored 2026-08-28 per docs/preflights/hera website revamp/Slice 1 fix 2.md.
// Four structural changes over the previous build:
//   1. The page arrives ALREADY IN THE STORY: the request is sent, the agent is
//      thinking, and a "Scroll down" cue is on screen. No blank black arrival, no
//      fake chat window, composer, caret, Send button, cursor travel or typing.
//   2. Pacing is budgeted, not guessed. Every beat below declares its enter and
//      hold distance in VIEWPORT-HEIGHTS OF SCROLL, and the track height is
//      derived from their sum. That makes "every major statement holds for at
//      least ~0.5-0.7 viewport-heights" a structural property of this file rather
//      than something to re-measure by hand.
//   3. The `.md` curtain DESCENDS from above the top edge instead of falling
//      past. Each column is long enough that its top always overruns the viewport
//      top, so the upper band reads as one continuous curtain; only the bottom
//      endpoint differs per column, which is what makes the lower edge jagged.
//   4. The human panic beats ACCUMULATE as a physical card pile instead of
//      swapping one-for-one. Earlier cards never leave; they recede behind the
//      new front card, so the visitor watches cleanup work pile up.
import { withBase } from '../data/site';

const logoWebp = withBase('images/hera/logo/hera-logo-1254.webp');
const logoPng = withBase('images/hera/logo/hera-logo-1254.png');
const mdIcon = withBase('images/ui/md-file-icon.png');

const MESSAGE = 'Make a small change to the website';

// The long verbose AI answer, reused verbatim from the original build. Kept whole :
// never clipped, never masked. Split into whitespace-separated words so the client
// script can reveal it progressively, mapped to scroll position.
const answerPara1 =
  'Better - but for a reason worth naming. Your instinct was right and the diagnosis was more literal than a layout preference: clicking a variant did change the answer, but the answer was rendered below the fold behind a collapse, and re-rendering the pane threw away its scroll position, so the screen snapped to the top. Two separate faults producing one feeling of "nothing responded." The scroll reset was a straight bug - panes now keep their own scrollTop across a render, so clicking a tile no longer moves the page at all. That fix alone was worth it.';
const answerPara2 =
  'The column is the other half. Selection has to change something at eye level, and it now does: the detail column sits beside the viewer, never scrolls away, never collapses, and fades on change so the swap is visible. The variant grid is where your cursor is; the answer is one glance right of the image it describes.';

const words1: string[] = answerPara1.split(/\s+/);
const words2: string[] = answerPara2.split(/\s+/);
const totalWords = words1.length + words2.length;

// The curtain is cued off the ACTUAL revealed-word position of the phrase
// "clicking a variant did change..." rather than an unrelated global percentage,
// so the paperwork starts while the answer has barely got going. Derived, not
// hardcoded: if the copy is edited the cue moves with it.
const cueWordIndex = Math.max(0, words1.indexOf('clicking'));

// Accumulating panic cards. Plain, recognisable AI-management interruptions :
// deliberately not marketing copy.
const panicCards = [
  "Wait: explain it like I'm ten.",
  'What are you actually saying?',
  'Did I send you the right file?',
  'Where is task.md?',
  'Did you write the closeout?',
  'Which file is current?',
  "Don't make a new branch.",
  'Merge the accepted one to main.',
];

const promises = [
  'You lead. It remembers what you already said.',
  'You lead. It knows what happens next.',
  'You lead. It knows where everything went.',
  'You lead. It keeps the work together.',
  'You lead. It stops when it actually needs you.',
];

// const FINAL_LINE = 'Stop managing your AI. Start giving it work.';


// ---------------------------------------------------------------------------
// Scroll budget. `enter` and `hold` are in VIEWPORT-HEIGHTS OF SCROLL TRAVEL.
// The hold is the readable state; the enter is the short transition into it.
// Every major readable beat holds >= 0.55vh, which at a 900px viewport is
// ~495px of wheel travel: several ordinary gestures, so no single flick can
// skip a statement or add three cards at once. Enter windows are deliberately
// short: in a shared slot the outgoing line fades across the first half and the
// incoming line across the second, so only one statement is legible at a time.
//
// The card and promise beats spend 0.12vh entering and the rest holding: ~85%
// of each beat is the readable state. That ratio (rather than a longer track)
// is what keeps fast flicking from catching these lines mid-transition; the
// measured wheel traversal in the closeout records both cadences.
// ---------------------------------------------------------------------------
type Beat = { key: string; enter: number; hold: number };

const BEATS: Beat[] = [
  // Arrival: request already sent, agent already thinking, cue already visible.
  { key: 'arrival', enter: 0.0, hold: 0.7 },
  // Thinking dissolves, the wall of answer unrolls. The curtain starts inside
  // this beat, at the "clicking a variant" cue word.
  { key: 'response', enter: 0.3, hold: 1.7 },
  // The curtain thickens to ~36% viewport depth across the full width.
  { key: 'curtain', enter: 0.0, hold: 1.4 },
  // Narrative exit: the story ends the rain, not the falling physics.
  { key: 'curtainExit', enter: 0.35, hold: 0.0 },
  // Eight panic cards. Each arrives, then holds while the pile grows behind it.
  { key: 'card1', enter: 0.12, hold: 0.61 },
  { key: 'card2', enter: 0.12, hold: 0.61 },
  { key: 'card3', enter: 0.12, hold: 0.61 },
  { key: 'card4', enter: 0.12, hold: 0.61 },
  { key: 'card5', enter: 0.12, hold: 0.61 },
  { key: 'card6', enter: 0.12, hold: 0.61 },
  { key: 'card7', enter: 0.12, hold: 0.61 },
  // The last card's hold is longer: it doubles as the "register the whole pile"
  // hold before the stack is cleared.
  { key: 'card8', enter: 0.12, hold: 1.06 },
  { key: 'stackExit', enter: 0.32, hold: 0.0 },
  // The two cost statements are the pivot of the whole sequence, and a
  // double-speed flick (720px) could outrun a 0.65vh hold. 0.85vh survives it.
  { key: 'painA', enter: 0.22, hold: 0.85 },
  { key: 'painB', enter: 0.22, hold: 0.85 },
  { key: 'painExit', enter: 0.28, hold: 0.0 },
  { key: 'introducing', enter: 0.22, hold: 0.55 },
  { key: 'brand', enter: 0.25, hold: 0.6 },
  { key: 'promise1', enter: 0.12, hold: 0.71 },
  { key: 'promise2', enter: 0.12, hold: 0.71 },
  { key: 'promise3', enter: 0.12, hold: 0.71 },
  { key: 'promise4', enter: 0.12, hold: 0.71 },
  { key: 'promise5', enter: 0.12, hold: 0.71 },
  { key: 'final', enter: 0.22, hold: 0.85 },
];

const totalVh = BEATS.reduce((sum, b) => sum + b.enter + b.hold, 0);

// key -> [start, holdStart, end] normalised to 0..1 scroll progress.
const marks: Record<string, [number, number, number]> = {};
{
  let cursor = 0;
  for (const b of BEATS) {
    const s = cursor / totalVh;
    const i = (cursor + b.enter) / totalVh;
    const e = (cursor + b.enter + b.hold) / totalVh;
    marks[b.key] = [s, i, e];
    cursor += b.enter + b.hold;
  }
}

// Track height = the scrollable budget plus the one pinned viewport.
const trackHeightVh = Math.round((totalVh + 1) * 100);

// The curtain begins at the revealed position of the cue word inside the
// response beat's reveal ramp (which runs the whole beat, enter + hold).
const rainStart =
  marks.response[0] + (cueWordIndex / totalWords) * (marks.response[2] - marks.response[0]);

// ---------------------------------------------------------------------------
// `.md` curtain. 16 authored columns that tile the full width edge to edge
// (left/width are derived in CSS from --i and --cols, so narrower breakpoints
// can drop to 10 or 6 columns and STILL tile edge to edge: no horizontal
// holes at any width). `depth` is the column's final bottom edge as a fraction
// of viewport height; the spread of depths is what shreds the bottom edge, and
// their mean (36.4% over all 16, 36.8% over the first 10, 35.3% over the first
// 6) is the "exit at 35-40% curtain depth" target at every breakpoint.
// `start`/`span` stagger each column's descent so the field never arrives as
// one tidy block.
// ---------------------------------------------------------------------------
const filenames = [
  'CURRENT-SPRINT.md',
  'handoff.md',
  'task-03-notes.md',
  'decision-log.md',
  'research.md',
  'FINAL-final-v2.md',
  'context-pack.md',
  'roadmap-update.md',
  'verification-notes.md',
  'handoff-latest-REAL.md',
  'fix-notes-final-final.md',
  'source-of-truth.md',
];

type RainColumn = { depth: number; start: number; span: number };

const rainColumns: RainColumn[] = [
  { depth: 0.4, start: 0.0, span: 0.62 },
  { depth: 0.29, start: 0.1, span: 0.55 },
  { depth: 0.45, start: 0.04, span: 0.7 },
  { depth: 0.33, start: 0.16, span: 0.58 },
  { depth: 0.38, start: 0.07, span: 0.66 },
  { depth: 0.27, start: 0.21, span: 0.52 },
  { depth: 0.43, start: 0.02, span: 0.68 },
  { depth: 0.31, start: 0.13, span: 0.6 },
  { depth: 0.36, start: 0.19, span: 0.56 },
  { depth: 0.46, start: 0.05, span: 0.72 },
  { depth: 0.3, start: 0.24, span: 0.54 },
  { depth: 0.41, start: 0.09, span: 0.64 },
  { depth: 0.34, start: 0.15, span: 0.59 },
  { depth: 0.28, start: 0.27, span: 0.51 },
  { depth: 0.44, start: 0.11, span: 0.69 },
  { depth: 0.37, start: 0.22, span: 0.57 },
  { depth: 0.32, start: 0.3, span: 0.53 },
  { depth: 0.42, start: 0.06, span: 0.71 },
  { depth: 0.35, start: 0.18, span: 0.61 },
  { depth: 0.39, start: 0.26, span: 0.5 },
];

// Long enough that at rest each column's TOP still overruns the viewport top by
// a wide margin: that overrun is what makes the upper band a continuous
// curtain instead of a scattering with sky between the streams.
const FILES_PER_COLUMN = 10;

const config = {
  marks,
  rainStart,
  totalWords,
  columns: rainColumns,
  cardCount: panicCards.length,
  promiseCount: promises.length,
};
---

<section id="opening-sequence" class="opening-sequence">
  <p class="sr-only">
    Scroll-controlled introduction: you have already asked an AI assistant to make a small change to
    a website, and it is thinking. It answers with a wall of text while ".md" files rain down from
    the top of the screen and bury the answer. A pile of panicked follow-up questions accumulates,
    then a plain statement of the cost: the AI finished in three minutes, you spent the next twenty
    digging through eighteen new ".md" files and begging it to explain itself. The sequence resolves
    on the HERA mark, five promises, and the line "Stop managing your AI. Start giving it work."
  </p>

  <div class="opening-track" id="opening-track">
    <div class="opening-stage" id="opening-stage" aria-hidden="true">
      <!-- Chat: no window, no card, no composer. The black page IS the canvas. -->
      <div class="chat-layer" id="chat-layer">
        <div class="chat-column">
          <div class="msg-row">
            <p class="user-bubble">{MESSAGE}</p>
          </div>
          <div class="thinking-row" id="thinking-row">
            <span class="thinking-dot"></span><span class="thinking-dot"></span><span
              class="thinking-dot"></span>
            <span class="thinking-label">Thinking&hellip;</span>
          </div>
          <div class="answer-row" id="answer-row">
            <p class="ai-line">
              {words1.map((w, i) => <><span class="rw" data-i={i}>{w}</span>{' '}</>)}
            </p>
            <p class="ai-line">
              {words2.map((w, i) => <><span class="rw" data-i={words1.length + i}>{w}</span>{' '}</>)}
            </p>
          </div>
        </div>
      </div>

      <div class="rain-layer" id="rain-layer">
        {
          rainColumns.map((_col, ci) => (
            <div class="rain-col" style={`--i:${ci};`}>
              <div class="rain-col-inner">
                {Array.from({ length: FILES_PER_COLUMN }).map((__, ri) => (
                  <div class="rain-file">
                    <img src={mdIcon} alt="" loading="eager" width="40" height="40" />
                    <span>{filenames[(ci * 5 + ri * 3) % filenames.length]}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Accumulating panic pile. Every card shares one grid cell so the group
           stays centred; z-index rises with index so each new card lands in
           front of the pile it joins. -->
      <div class="panic-layer" id="panic-layer">
        <div class="panic-stack" id="panic-stack">
          {
            panicCards.map((t, i) => (
              <p
                class:list={['panic-card', i === panicCards.length - 1 && 'is-urgent']}
                data-card={i}
                style={`z-index:${i + 1};`}
              >
                {t}
              </p>
            ))
          }
        </div>
      </div>

      <!-- One stable statement slot: both pain lines are overlaid on the same
           grid cell, so the second replaces the first without moving. -->
      <div class="pain-layer" id="pain-layer">
        <div class="statement-slot">
          <p class="statement" data-slot="0">Your AI finished in 3 minutes.</p>
          <p class="statement" data-slot="1">
            You spent the next 20 digging through 18 new .md files and begging it to explain itself.
          </p>
        </div>
      </div>

      <div class="hera-layer" id="hera-layer">
        <p class="hera-eyebrow" id="hera-eyebrow">Introducing</p>
        <div class="hera-brand" id="hera-brand">
          <picture>
            <source srcset={logoWebp} type="image/webp" />
            <img class="hera-logo" src={logoPng} alt="" width="120" height="120" />
          </picture>
          <span class="hera-word">HERA</span>
        </div>
        <!-- The five promises AND the final line share one slot. The final line
             is the sixth overlaid child, not a separate element elsewhere, so it
             cannot jump vertically when it replaces promise five. -->
        <div class="statement-slot hera-slot" id="hera-slot">
          {promises.map((t, i) => <p class="statement" data-slot={i}>{t}</p>)}
          <p class="statement is-final" data-slot={promises.length}>
            Stop managing your AI.<br>
            Start giving it work.
            </p>
        </div>
      </div>

      <div class="opening-scroll-cue" id="opening-scroll-cue">
        <span class="cue-label">Scroll down</span>
        <span class="cue-arrow">&darr;</span>
      </div>
    </div>
  </div>

  <script type="application/json" id="opening-config" set:html={JSON.stringify(config)} />
</section>

<style define:vars={{ trackHeight: `${trackHeightVh}vh` }}>
  /* The sticky nav occupies real flow height at the top of the document, which
     pushed this section down by that much. At scrollY=0 the pinned stage was
     therefore hanging ~69px below the fold and clipping the "Scroll down" cue :
     the one thing that must be legible on arrival. Pulling the section up by
     exactly the header's height starts the cinematic at the true top of the
     page and lets the floating nav pill sit over the black canvas, which is the
     intended composition. The fallback below matches the measured desktop
     header; the script overwrites it with the real value per breakpoint. */
  .opening-sequence {
    position: relative;
    margin-top: calc(-1 * var(--opening-nav-offset, 4.33rem));
  }

  .opening-track {
    position: relative;
    height: var(--trackHeight);
  }

  .opening-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: #000;
    color: #f4f4f2;

    /* ONE cinematic statement scale. Panic cards, both pain lines, all five
       promises and the final line read from this single source of truth, so the
       opening stops jumping between unrelated font sizes. The documented
       exceptions (setup bubble, body-copy response, small eyebrow, big
       wordmark) are the only sizes authored outside it. */
    --opening-statement-size: clamp(1.8rem, 3vw, 2.8rem);
  }

  .chat-layer,
  .rain-layer,
  .panic-layer,
  .pain-layer,
  .hera-layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .rain-layer,
  .panic-layer,
  .pain-layer,
  .hera-layer {
    opacity: 0;
  }

  /* Chat: black canvas, no window chrome ------------------------------ */
  /* Anchored near the top rather than vertically centred, for two reasons: a
     real conversation grows downward from the top, and the curtain only
     descends to ~36% of the viewport: with a centred column the falling files
     would stop just above the answer instead of burying its opening lines. */
  .chat-layer {
    align-items: flex-start;
    padding-top: clamp(88px, 13vh, 150px);
  }

  .chat-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: min(880px, 72vw);
    text-align: left;
  }

  .msg-row {
    display: flex;
    justify-content: flex-end;
  }

  /* The setup, not the punchline: deliberately smaller than the cinematic
     statement scale. Geometry reuses the established `.user-bubble-mini` shape
     from src/pages/index.astro (Astro scopes styles per file, so the values are
     authored again here rather than inherited). */
  .user-bubble {
    max-width: 78%;
    margin: 0;
    padding: 13px 18px;
    border-radius: 22px 22px 7px 22px;
    background: rgba(244, 241, 234, 0.96);
    color: #090909;
    font-size: 15px;
    line-height: 1.42;
    letter-spacing: -0.012em;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.24);
  }

  .thinking-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .thinking-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(244, 244, 242, 0.6);
    animation: thinkingPulse 1.1s ease-in-out infinite;
  }

  .thinking-dot:nth-child(2) {
    animation-delay: 0.15s;
  }
  .thinking-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes thinkingPulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .thinking-label {
    font-size: 14px;
    color: rgba(244, 244, 242, 0.6);
    margin-left: 2px;
  }

  /* Readable body copy: the answer has to be legible before the curtain
     starts covering it, so it is body size, not "demo screenshot" size. */
  .answer-row {
    font-size: clamp(1rem, 1.35vw, 1.32rem);
    line-height: 1.62;
  }

  .ai-line {
    color: rgba(244, 244, 242, 0.82);
    margin: 0 0 14px;
  }

  .ai-line:last-child {
    margin-bottom: 0;
  }

  .rw {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .rw.is-shown {
    opacity: 1;
  }

  /* .md curtain --------------------------------------------------------- */
  .rain-layer {
    --cols: 20;
    z-index: 3;
  }

  /* left/width derived from --i and --cols so the columns always tile the full
     width with no gaps, at every breakpoint's column count. */
  .rain-col {
    position: absolute;
    top: 0;
    left: calc(var(--i) * (100% / var(--cols)));
    width: calc(100% / var(--cols));
  }

  .rain-col-inner {
    display: flex;
    flex-direction: column;
    gap: 2px;
    will-change: transform;
  }

  /* Tiles are sized as a FRACTION OF THEIR COLUMN and packed with almost no
     gutter, so the field reads as one mass rather than isolated icons with
     black sky between them. The near-opaque plate is what makes the curtain
     actually bury the answer rather than float in front of it. */
  .rain-file {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 1px;
    background: rgba(0, 0, 0, 0.9);
  }

  .rain-file img {
    width: 78%;
    height: auto;
  }

  /* Filenames wrap; they are never truncated at any width. */
  .rain-file span {
    width: 100%;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: break-word;
    text-align: center;
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(244, 244, 242, 0.85);
  }

  /* Panic pile ---------------------------------------------------------- */
  .panic-stack {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(500px, 36vw, 680px);
    max-width: 88vw;
  }

  .panic-card {
    grid-area: 1 / 1;
    margin: 0;
    width: 100%;
    padding: 26px 30px;
    border-radius: 24px 24px 8px 24px;
    background: #f4f1ea;
    /* --card-text fades to 0 as a card recedes, so only the front card is
       readable. A pile of paper shows its edges, not the writing underneath;
       leaving the text legible on every layer read as a rendering fault. */
    color: rgba(9, 9, 9, var(--card-text, 1));
    border: 1px solid rgba(0, 0, 0, 0.34);
    /* Same cinematic statement scale as the pain lines and HERA promises. */
    font-size: var(--opening-statement-size);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-align: left;
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.5);
    opacity: 0;
    will-change: transform, opacity;
  }

  /* Urgency by tone only: identical geometry and identical type scale. */
  .panic-card.is-urgent {
    background: #e7cfcb;
    color: rgba(61, 15, 15, var(--card-text, 1));
  }

  /* Statement slots ----------------------------------------------------- */
  /* Every candidate line occupies the SAME grid cell, centred. Swapping which
     one is opaque cannot move the text, which is what keeps pain A -> pain B
     and promise 5 -> final line anchored. */
  .statement-slot {
    display: grid;
    place-items: center;
    width: min(900px, 84vw);
    padding: 0 8px;
  }

  .statement-slot > * {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    text-align: center;
  }

  .statement {
    font-size: var(--opening-statement-size);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .statement.is-final {
    color: #fff;
  }

  /* HERA reveal --------------------------------------------------------- */
  .hera-layer {
    flex-direction: column;
    gap: clamp(14px, 2.2vh, 26px);
    text-align: center;
    padding: 0 24px;
  }

  .hera-eyebrow {
    margin: 0;
    opacity: 0;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 244, 242, 0.62);
  }

  /* [logo] HERA on ONE horizontal row: logo left, word right. */
  .hera-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 1.6vw, 24px);
    opacity: 0;
  }

  .hera-logo {
    width: clamp(58px, 7vw, 96px);
    height: auto;
    animation: hera-logo-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hera-logo-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 8px rgba(158, 129, 254, 0.58))
        drop-shadow(0 0 18px rgba(76, 91, 255, 0.28));
    }
    50% {
      filter: drop-shadow(0 0 18px rgba(214, 202, 254, 0.88))
        drop-shadow(0 0 28px rgba(76, 91, 255, 0.5));
    }
  }

  .hera-word {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .hera-slot {
    margin-top: clamp(4px, 1.4vh, 18px);
  }

  /* Scroll affordance: unmistakable but quiet, and present at arrival --- */
  .opening-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(20px, 4vh, 44px);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0;
    z-index: 20;
  }

  .cue-label {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 244, 242, 0.66);
  }

  .cue-arrow {
    display: block;
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    color: rgba(244, 244, 242, 0.82);
    animation: cueNudge 1.8s ease-in-out infinite;
  }

  @keyframes cueNudge {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* Laptop / tablet ------------------------------------------------------ */
  @media (max-width: 900px) {
    .rain-layer {
      --cols: 12;
    }
    .rain-col:nth-child(n + 13) {
      display: none;
    }
    .chat-column {
      width: min(760px, 84vw);
    }
    .panic-stack {
      width: min(84vw, 560px);
    }
  }

  /* Mobile --------------------------------------------------------------- */
  @media (max-width: 640px) {
    .opening-stage {
      --opening-statement-size: clamp(1.35rem, 5.6vw, 1.95rem);
    }

    .rain-layer {
      --cols: 7;
    }
    .rain-col:nth-child(n + 8) {
      display: none;
    }

    .chat-layer {
      padding-top: clamp(80px, 11vh, 120px);
    }

    .chat-column {
      width: 88vw;
      gap: 14px;
    }

    .user-bubble {
      font-size: 14px;
    }

    .answer-row {
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .rain-file {
      padding: 3px 1px;
      gap: 1px;
    }
    .rain-file span {
      font-size: 7px;
    }

    /* 86vw leaves room for the pile's own offsets without clipping. */
    .panic-stack {
      width: 86vw;
      max-width: 86vw;
    }

    .panic-card {
      padding: 18px 20px;
      border-radius: 18px 18px 7px 18px;
    }

    .statement-slot {
      width: 88vw;
    }

    .hera-word {
      font-size: clamp(2.6rem, 13vw, 4rem);
    }

    .hera-logo {
      width: clamp(46px, 12vw, 68px);
    }
  }

  /* Reduced motion: same story, discrete readable states. The scroll->state
     mapping is unchanged (so no copy is ever skipped); what changes is that
     opacities snap instead of crossfading, cards land without travel, and the
     curtain is placed statically at its resting depth instead of descending. */
  @media (prefers-reduced-motion: reduce) {
    .rw,
    .thinking-dot,
    .hera-logo,
    .cue-arrow,
    .panic-card {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  type Beat = [number, number, number];
  type Marks = Record<string, Beat>;
  type RainCfg = { depth: number; start: number; span: number };
  type Config = {
    marks: Marks;
    rainStart: number;
    totalWords: number;
    columns: RainCfg[];
    cardCount: number;
    promiseCount: number;
  };

  const stage = document.getElementById('opening-stage');
  const track = document.getElementById('opening-track');
  const configEl = document.getElementById('opening-config');

  if (stage && track && configEl && configEl.textContent) {
    const cfg: Config = JSON.parse(configEl.textContent);
    const M = cfg.marks;

    const byId = (id: string) => document.getElementById(id) as HTMLElement;
    const chatLayer = byId('chat-layer');
    const rainLayer = byId('rain-layer');
    const panicLayer = byId('panic-layer');
    const painLayer = byId('pain-layer');
    const heraLayer = byId('hera-layer');
    const thinkingRow = byId('thinking-row');
    const heraEyebrow = byId('hera-eyebrow');
    const heraBrand = byId('hera-brand');
    const scrollCue = byId('opening-scroll-cue');

    const wordSpans = Array.from(document.querySelectorAll<HTMLElement>('#answer-row .rw'));
    const panicEls = Array.from(
      document.querySelectorAll<HTMLElement>('#panic-stack > .panic-card')
    );
    const painEls = Array.from(
      document.querySelectorAll<HTMLElement>('#pain-layer .statement-slot > *')
    );
    const heraEls = Array.from(document.querySelectorAll<HTMLElement>('#hera-slot > *'));

    const rainCols = Array.from(document.querySelectorAll<HTMLElement>('.rain-col')).map(
      (el, i) => ({
        inner: el.querySelector<HTMLElement>('.rain-col-inner'),
        depth: cfg.columns[i].depth,
        start: cfg.columns[i].start,
        span: cfg.columns[i].span,
      })
    );

    const clamp01 = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reduced motion keeps the identical scroll->beat mapping and simply snaps,
    // so the story order and every line survive with animation disabled.
    const op = (v: number) => (reduced ? (v >= 0.5 ? 1 : 0) : v);
    const ease = (t: number) => (reduced ? (t >= 0.5 ? 1 : 0) : 1 - (1 - t) * (1 - t));

    // A slot member is opaque across its own hold, fades in over the SECOND half
    // of its own enter window, and fades out over the FIRST half of the next
    // beat's enter window. That ordering is what keeps exactly one statement
    // legible at a time in a shared slot.
    const slotOpacity = (p: number, beat: Beat, next: Beat | null) => {
      const s = beat[0];
      const i = beat[1];
      if (p < s) return 0;
      if (p < i) return clamp01((p - (s + (i - s) / 2)) / Math.max(1e-6, (i - s) / 2));
      if (!next) return 1;
      const ns = next[0];
      const ni = next[1];
      if (p < ns) return 1;
      const half = Math.max(1e-6, (ni - ns) / 2);
      if (p < ns + half) return clamp01(1 - (p - ns) / half);
      return 0;
    };

    // Fades in over the second half of its enter and then stays: used by the
    // elements that must remain fixed on screen (Introducing, the brand row).
    const persistOpacity = (p: number, beat: Beat) => {
      const s = beat[0];
      const i = beat[1];
      if (p < s) return 0;
      if (p >= i) return 1;
      return clamp01((p - (s + (i - s) / 2)) / Math.max(1e-6, (i - s) / 2));
    };

    let lastRevealed = -1;
    const setRevealed = (count: number) => {
      if (count === lastRevealed) return;
      wordSpans.forEach((el, i) => el.classList.toggle('is-shown', i < count));
      lastRevealed = count;
    };

    const applySlot = (p: number, els: HTMLElement[], beats: Beat[], tail: Beat | null) => {
      let maxOp = 0;
      els.forEach((el, i) => {
        const next = i + 1 < beats.length ? beats[i + 1] : tail;
        const o = op(slotOpacity(p, beats[i], next));
        el.style.opacity = String(o);
        el.style.transform = reduced ? 'none' : 'translateY(' + ((1 - o) * 12).toFixed(2) + 'px)';
        if (o > maxOp) maxOp = o;
      });
      return maxOp;
    };

    let viewportHeight = window.innerHeight;

    const cardBeats: Beat[] = [];
    for (let i = 1; i <= cfg.cardCount; i += 1) cardBeats.push(M['card' + i]);
    const painBeats: Beat[] = [M.painA, M.painB];
    const heraBeats: Beat[] = [
      M.promise1,
      M.promise2,
      M.promise3,
      M.promise4,
      M.promise5,
      M.final,
    ];

    // Both the chat and the curtain leave on the same decisive narrative exit.
    const exitFade = (p: number) =>
      p < M.curtainExit[0]
        ? 1
        : clamp01(1 - (p - M.curtainExit[0]) / Math.max(1e-6, M.curtainExit[2] - M.curtainExit[0]));

    const updateChat = (p: number) => {
      chatLayer.style.opacity = String(op(exitFade(p)));

      // "Thinking..." is present at arrival and dissolves as the answer starts.
      const think =
        p < M.response[0]
          ? 1
          : clamp01(1 - (p - M.response[0]) / Math.max(1e-6, M.response[1] - M.response[0]));
      thinkingRow.style.opacity = String(op(think));

      const t = clamp01((p - M.response[0]) / Math.max(1e-6, M.response[2] - M.response[0]));
      setRevealed(Math.round(t * cfg.totalWords));
    };

    const updateRain = (p: number) => {
      if (p < cfg.rainStart) {
        rainLayer.style.opacity = '0';
        return;
      }
      const fade = exitFade(p);
      rainLayer.style.opacity = String(op(fade));
      if (fade <= 0) return;

      const span = Math.max(1e-6, M.curtain[2] - cfg.rainStart);
      const t = clamp01((p - cfg.rainStart) / span);

      rainCols.forEach((col) => {
        if (!col.inner) return;
        const h = col.inner.offsetHeight;
        if (!h) return; // hidden at this breakpoint
        // Clamped so the column top always overruns the viewport top by >=90px:
        // that overrun is the "no giant hole at the top" guarantee.
        const restBottom = Math.min(col.depth * viewportHeight, h - 90);
        const local = reduced ? 1 : clamp01((t - col.start) / col.span);
        const eased = 1 - (1 - local) * (1 - local);
        const y = lerp(-h - 60, restBottom - h, eased);
        col.inner.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
      });
    };

    // Fractional index of the front card. Integer while a card holds; ramps
    // from i-1 to i across that card's enter window.
    const frontIndex = (p: number) => {
      let front = -1;
      for (let i = 0; i < cardBeats.length; i += 1) {
        const s = cardBeats[i][0];
        const h = cardBeats[i][1];
        if (p >= h) {
          front = i;
        } else if (p >= s) {
          front = i - 1 + ease(clamp01((p - s) / Math.max(1e-6, h - s)));
          break;
        } else {
          break;
        }
      }
      return front;
    };

    const updatePanic = (p: number) => {
      if (p < cardBeats[0][0]) {
        panicLayer.style.opacity = '0';
        return;
      }
      // The pile clears decisively, all at once, into the cost statement.
      const fade =
        p < M.stackExit[0]
          ? 1
          : clamp01(1 - (p - M.stackExit[0]) / Math.max(1e-6, M.stackExit[2] - M.stackExit[0]));
      panicLayer.style.opacity = String(op(fade));
      if (fade <= 0) return;

      // Offsets are trimmed on narrow screens so an 86vw card cannot be pushed
      // off the left edge as the pile deepens.
      const narrow = window.innerWidth <= 640;
      const stepX = narrow ? 3 : 7;
      const stepY = narrow ? 12 : 16;

      const front = frontIndex(p);
      panicEls.forEach((el, i) => {
        const rel = front - i;
        if (rel <= -1) {
          // Not yet dealt onto the pile.
          el.style.opacity = '0';
          el.style.transform = 'translate3d(0,46px,0) scale(0.96)';
          el.style.setProperty('--card-text', '0');
          return;
        }
        if (rel < 0) {
          // Arriving: rises into the front position.
          const t = rel + 1;
          el.style.opacity = String(t);
          el.style.setProperty('--card-text', String(t));
          el.style.transform =
            'translate3d(0,' +
            (46 * (1 - t)).toFixed(1) +
            'px,0) scale(' +
            (0.96 + 0.04 * t).toFixed(3) +
            ')';
          return;
        }
        // Settled, and receding as newer cards land on top. Earlier cards never
        // disappear: the accumulating pile is the point.
        const d = reduced ? Math.round(rel) : rel;
        const dc = d > 7 ? 7 : d;
        const rot = (i % 2 === 0 ? -1 : 1) * (dc > 2 ? 2 : dc) * 0.9;
        el.style.opacity = String(Math.max(0.32, 1 - dc * 0.085));
        el.style.setProperty('--card-text', String(Math.max(0, 1 - dc * 1.4)));
        el.style.transform =
          'translate3d(' +
          (-dc * stepX).toFixed(1) +
          'px,' +
          (-dc * stepY).toFixed(1) +
          'px,0) rotate(' +
          rot.toFixed(2) +
          'deg) scale(' +
          Math.max(0.83, 1 - dc * 0.024).toFixed(3) +
          ')';
      });
    };

    const updateAll = (p: number) => {
      updateChat(p);
      updateRain(p);
      updatePanic(p);

      painLayer.style.opacity = String(applySlot(p, painEls, painBeats, M.painExit));

      const eyebrow = op(persistOpacity(p, M.introducing));
      const brand = op(persistOpacity(p, M.brand));
      heraEyebrow.style.opacity = String(eyebrow);
      heraBrand.style.opacity = String(brand);
      const promiseMax = applySlot(p, heraEls, heraBeats, null);
      heraLayer.style.opacity = String(Math.max(eyebrow, brand, promiseMax));

      // The cue is on screen at arrival (so the visitor knows scrolling is the
      // interaction) and again on the final line (so they know it continues).
      const cueIn =
        p < M.response[1]
          ? clamp01(1 - (p - M.arrival[2]) / Math.max(1e-6, M.response[1] - M.arrival[2]))
          : 0;
      const cueOut = persistOpacity(p, M.final);
      scrollCue.style.opacity = String(op(Math.max(cueIn, cueOut)));
    };

    let trackTop = 0;
    let trackHeight = 0;
    let ticking = false;

    // Exact per-breakpoint value for the negative top margin explained in the
    // stylesheet. Measured rather than hardcoded because the pill's height moves
    // with the font and the breakpoint.
    const section = document.getElementById('opening-sequence');
    const header = document.querySelector('header');
    const applyNavOffset = () => {
      if (!section || !header) return;
      const h = header.getBoundingClientRect().height;
      if (h > 0) section.style.setProperty('--opening-nav-offset', h + 'px');
    };

    const measure = () => {
      const rect = track.getBoundingClientRect();
      trackTop = Math.round(rect.top + window.scrollY);
      trackHeight = track.offsetHeight;
      viewportHeight = window.innerHeight;
    };

    const computeP = () =>
      clamp01((window.scrollY - trackTop) / Math.max(1, trackHeight - viewportHeight));

    const frame = () => {
      ticking = false;
      updateAll(computeP());
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      applyNavOffset();
      measure();
      onScroll();
    });
    // Webfont swap changes the pill's height after first paint.
    window.addEventListener('load', () => {
      applyNavOffset();
      measure();
      onScroll();
    });

    applyNavOffset();
    measure();
    updateAll(computeP());

    // Exposed only for automated verification (Playwright checkpoint capture);
    // nothing in the page itself reads it.
    (window as unknown as Record<string, unknown>).__openingMarks = {
      marks: M,
      rainStart: cfg.rainStart,
    };
  }
</script>
