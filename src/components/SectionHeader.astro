---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl reveal', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <h2 class="text-h2 font-semibold tracking-tight">{title}</h2>
  {description && <p class="mt-4 text-lead text-muted">{description}</p>}
</div>
