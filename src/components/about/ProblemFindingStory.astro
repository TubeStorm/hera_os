  .gate{width:min(500px,100%);opacity:0}.slide.active .gate{animation:fadeUp .3s ease 1.45s forwards}.gate>small{display:block;margin-bottom:7px;text-align:center;color:var(--muted);font-size:.5rem;font-weight:750;letter-spacing:.08em}.gate>div{display:grid;grid-template-columns:1fr 1fr;gap:7px}.gate span{padding:10px;border-radius:10px;font-size:.58rem}.gate b{margin-right:5px}.yes{background:rgba(174,224,189,.09);color:#aee0bd}.no{background:rgba(216,189,111,.09);color:var(--ink)}
