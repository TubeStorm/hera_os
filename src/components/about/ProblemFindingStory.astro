</section>

<style>
  .story-carousel{position:relative;margin-top:clamp(54px,8vw,92px);padding:0 clamp(0px,4vw,56px);outline:none}
  .slides{max-width:980px;margin:auto}
  .slide{display:none}.slide.active{display:block;animation:slideIn .32s cubic-bezier(.2,.82,.2,1)}
  @keyframes slideIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  /* Shared kicker style (used across all slides) */
  .kicker{margin:0 0 9px;color:var(--muted);font-size:.76rem;font-weight:700;letter-spacing:.085em;text-transform:uppercase}

  /* ── SLIDE 1 WRAPPER (positions the canvas-attached arrow) ── */
  .slide1-wrapper{
    position:relative;
  }

  /* ── SLIDE 1 LAYOUT ──────────────────────────────────────── */
  .slide1-layout{
    display:grid;
    grid-template-columns:minmax(0,42fr) minmax(0,58fr);
    gap:clamp(32px,5vw,64px);
    align-items:center;
    min-height:440px;
  }
  .slide1-copy{
    display:flex;
    flex-direction:column;
    gap:0;
    padding:clamp(12px,2vw,24px) 0;
  }
  .slide1-bold{
    margin:10px 0 0;
    color:var(--ink);
    font-size:clamp(1.1rem,1.6vw,1.35rem);
    line-height:1.45;
    font-weight:700;
    letter-spacing:-.02em;
  }
  .slide1-body{
    margin:14px 0 0;
    color:var(--muted);
    font-size:1rem;
    line-height:1.7;
  }

  /* ── SLIDE 1 CANVAS-ATTACHED NEXT ARROW ─────────────────── */
  .s1-next-arrow{
    position:absolute;
    /* sits just outside the right edge of the visual canvas */
    right:-58px;
    /* vertically centred on the canvas itself (42% copy + 58% canvas; arrow target = canvas centre) */
    top:50%;
    transform:translateY(-50%);
    z-index:10;
    width:46px;
    height:46px;
    display:grid;
    place-items:center;
    border-radius:50%;
    border:0;
    background:rgba(14,14,16,.85);
    backdrop-filter:blur(8px);
    color:rgba(255,255,255,.75);
    font-size:1.1rem;
    cursor:pointer;
    box-shadow:0 0 0 1px rgba(255,255,255,.06),0 8px 24px rgba(0,0,0,.4);
    animation:arrowNudge 1.35s ease-in-out infinite;
    transition:background .2s,box-shadow .2s,color .2s;
  }
  .s1-next-arrow:hover{
    background:rgba(30,30,32,.95);
    color:#fff;
    box-shadow:0 0 0 1px rgba(255,255,255,.12),0 12px 32px rgba(0,0,0,.5);
  }
  .s1-next-arrow:focus-visible{outline:2px solid #fff;outline-offset:4px}
  @keyframes arrowNudge{
    0%,100%{transform:translateY(-50%) translateX(0)}
    50%{transform:translateY(-50%) translateX(7px)}
  }

  /* ── BRAIN CANVAS ────────────────────────────────────────── */
  .brain-canvas{
    position:relative;
    min-height:480px;
    border-radius:24px;
    background:#000;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  /* Primary red stress glow */
  .brain-glow{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    pointer-events:none;
  }
  .brain-glow::before{
    /* inner hot core */
    content:'';
    position:absolute;
    width:160px;
    height:160px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(200,30,20,.55) 0%,rgba(185,25,15,.22) 40%,transparent 70%);
    animation:glowPulse 3.1s ease-in-out infinite;
  }
  .brain-glow::after{
    /* outer soft bloom */
    content:'';
    position:absolute;
    width:320px;
    height:320px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(180,20,10,.18) 0%,rgba(160,15,5,.06) 45%,transparent 68%);
    animation:glowPulse 3.1s ease-in-out infinite;
    animation-delay:.4s;
  }
  @keyframes glowPulse{
    0%,100%{transform:scale(1);opacity:.75}
    50%{transform:scale(1.32);opacity:1}
  }

  /* Secondary faint ring */
  .brain-ring{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    pointer-events:none;
    z-index:1;
  }
  .brain-ring::after{
    content:'';
    width:240px;
    height:240px;
    border-radius:50%;
    border:1px solid rgba(200,40,20,.12);
    animation:ringPulse 3.1s ease-in-out infinite;
    animation-delay:.8s;
  }
  @keyframes ringPulse{
    0%,100%{transform:scale(.9);opacity:.3}
    50%{transform:scale(1.15);opacity:.7}
  }

  /* Brain icon — larger (15% bigger than previous 96px) */
  .brain-icon{
    position:relative;
    z-index:2;
    width:112px;
    height:112px;
    animation:brainPulse 3.1s ease-in-out infinite;
    flex:none;
  }
  .brain-icon svg{width:100%;height:100%;display:block}
  @keyframes brainPulse{
    0%,100%{transform:scale(1)}
    50%{transform:scale(1.06)}
  }

  /* ── FLOATING THOUGHTS ───────────────────────────────────── */
  .thought{
    position:absolute;
    z-index:3;
    color:rgba(255,255,255,.48);
    font-size:.69rem;
    line-height:1.3;
    white-space:nowrap;
    opacity:0;
  }
  /* Pill variant (most thoughts) */
  .thought:not(.th-blur){
    padding:6px 13px;
    border-radius:999px;
    background:rgba(255,255,255,.055);
  }
  /* Blur-backing variant (two thoughts near brain — softer, less UI) */
  .th-blur{
    padding:5px 10px;
    background:rgba(10,10,12,.6);
    backdrop-filter:blur(6px);
    border-radius:8px;
    font-size:.65rem;
  }
  /* Size variants */
  .th-sm{ font-size:.63rem; }
  .th-md{ font-size:.71rem; }
  .th-lg{ font-size:.69rem; white-space:normal; max-width:200px; text-align:center; }
  /* Opacity variants */
  .th-dim{ opacity:0; } /* overridden when active */

  /* Fade-in on slide activation */
  .slide.active .thought{ opacity:1; transition:opacity .5s ease .25s; }
  .slide.active .th-dim{  opacity:.32; }

  /* Individual drift animations — each thought gets its own */
  .thought:nth-of-type(1){ animation:tDrift1 11s ease-in-out 0s    infinite alternate; }
  .thought:nth-of-type(2){ animation:tDrift2 13s ease-in-out -3.2s infinite alternate; }
  .thought:nth-of-type(3){ animation:tDrift3 14s ease-in-out -6.8s infinite alternate; }
  .thought:nth-of-type(4){ animation:tDrift4 12s ease-in-out -1.8s infinite alternate; }
  .thought:nth-of-type(5){ animation:tDrift5 15s ease-in-out -8.5s infinite alternate; }
  .thought:nth-of-type(6){ animation:tDrift6 10s ease-in-out -4.7s infinite alternate; }
  .thought:nth-of-type(7){ animation:tDrift7 16s ease-in-out -2.4s infinite alternate; }
  .thought:nth-of-type(8){ animation:tDrift8  9s ease-in-out -7.1s infinite alternate; }
  .thought:nth-of-type(9){ animation:tDrift9 13s ease-in-out -5.5s infinite alternate; }
  @keyframes tDrift1{ 0%{transform:translate(0,0)} 50%{transform:translate(4px,-6px)} 100%{transform:translate(-5px,4px)} }
  @keyframes tDrift2{ 0%{transform:translate(0,0)} 50%{transform:translate(-5px,7px)} 100%{transform:translate(6px,-3px)} }
  @keyframes tDrift3{ 0%{transform:translate(0,0)} 50%{transform:translate(3px,8px)} 100%{transform:translate(-4px,-5px)} }
  @keyframes tDrift4{ 0%{transform:translate(0,0)} 50%{transform:translate(-6px,-5px)} 100%{transform:translate(4px,6px)} }
  @keyframes tDrift5{ 0%{transform:translate(0,0)} 50%{transform:translate(5px,-4px)} 100%{transform:translate(-3px,7px)} }
  @keyframes tDrift6{ 0%{transform:translate(0,0)} 50%{transform:translate(-7px,5px)} 100%{transform:translate(5px,-6px)} }
  @keyframes tDrift7{ 0%{transform:translate(0,0)} 50%{transform:translate(3px,6px)} 100%{transform:translate(-6px,-4px)} }
  @keyframes tDrift8{ 0%{transform:translate(0,0)} 50%{transform:translate(-4px,-7px)} 100%{transform:translate(6px,3px)} }
  @keyframes tDrift9{ 0%{transform:translate(0,0)} 50%{transform:translate(6px,-4px)} 100%{transform:translate(-5px,6px)} }

  /* ── SLIDE 2 — Context story ───────────────────────────── */
  .s2-layout{display:grid;grid-template-columns:minmax(0,42fr) minmax(0,58fr);gap:clamp(32px,5vw,64px);align-items:center;min-height:440px}
  .s2-copy{display:flex;flex-direction:column;padding:clamp(12px,2vw,24px) 0}
  .s2-bold{margin:10px 0 0;color:var(--ink);font-size:clamp(1.1rem,1.6vw,1.35rem);line-height:1.45;font-weight:700;letter-spacing:-.02em}
  .s2-body{margin:14px 0 0;color:var(--muted);font-size:1rem;line-height:1.7}
  .s2-canvas{position:relative;min-height:500px;border-radius:24px;background:#000;overflow:hidden;display:flex;flex-direction:column;padding:18px 20px 22px}

  /* Production-inspired workspace tabs: fixed at the top centre, no close icons. */
  .s2-toggle{position:relative;align-self:center;display:flex;align-items:flex-end;margin:0 auto 18px;height:42px}
  .s2-tab{min-width:150px;height:40px;padding:0 16px;border:1px solid transparent;border-bottom-color:rgba(255,255,255,.07);border-radius:14px 14px 0 0;background:#09090a;color:rgba(255,255,255,.38);font:600 .72rem/1 system-ui,sans-serif;cursor:default;pointer-events:none;transition:color .35s ease,background .35s ease,border-color .35s ease}
  .s2-tab.s2-tab-active{background:#121214;border-color:rgba(255,255,255,.12);border-bottom-color:#121214;color:#f5f3ee}
  .s2-cursor{position:absolute;pointer-events:none;z-index:8;left:68px;top:29px;opacity:1;transition:transform .65s cubic-bezier(.22,.8,.25,1)}
  .s2-cursor.is-context{transform:translateX(150px)}
  .s2-cursor svg{display:block;filter:drop-shadow(0 2px 5px #000)}

  /* One invariant grid owns both scenarios, so context can never squeeze the chat. */
  .s2-panel{flex:1;display:grid;grid-template-columns:minmax(0,1fr) 142px;gap:20px;min-height:398px}
  .s2-chat{width:100%;display:flex;flex-direction:column;gap:9px;padding-top:2px}
  .s2-msg{display:flex;flex-direction:column;gap:4px;max-width:90%}
  .s2-who{font-size:.53rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.38)}
  .s2-text{font-size:.81rem;line-height:1.48}
  .s2-user{align-self:flex-end;padding:11px 15px;border-radius:18px 18px 5px 18px;background:#f0ede7;color:#121214}
  .s2-user-long{max-width:95%}
  .s2-agent{align-self:flex-start;padding:7px 4px;color:rgba(255,255,255,.82)}
  .s2-gap{display:flex;align-items:center;gap:9px;width:76%;align-self:center;color:rgba(255,255,255,.3);font:600 .54rem/1 system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase}
  .s2-gap::before,.s2-gap::after{content:"";height:1px;flex:1;background:rgba(255,255,255,.1)}
  .s2-gap span{white-space:nowrap}

  .s2-thinking{min-height:30px;display:flex;align-items:center;gap:4px;padding:5px 4px;color:rgba(255,255,255,.52)}
  .s2-thinking span{width:4px;height:4px;border-radius:50%;background:#d8bd6f;animation:s2Think 1s ease-in-out infinite}
  .s2-thinking span:nth-child(2){animation-delay:.15s}.s2-thinking span:nth-child(3){animation-delay:.3s}
  .s2-thinking b{margin-left:5px;font:500 .66rem/1.2 system-ui,sans-serif}
  .s2-result{opacity:0;transform:translateY(7px);transition:opacity .38s ease,transform .38s ease}
  .s2-panel[data-phase="answered"] .s2-thinking{visibility:hidden}
  .s2-panel[data-phase="answered"] .s2-result{opacity:1;transform:none}
  .s2-canvas[data-mode="0"] .s2-result .s2-text{color:#ff7667}
  .s2-canvas[data-mode="1"] .s2-result .s2-text{color:#aee0bd;font-weight:650}
  @keyframes s2Think{0%,60%,100%{opacity:.28;transform:translateY(0)}30%{opacity:1;transform:translateY(-2px)}}

  .s2-context-col{display:flex;flex-direction:column;justify-content:flex-start;padding-top:3px;opacity:0;transform:translateX(8px);transition:opacity .45s ease,transform .45s ease;pointer-events:none}
  .s2-canvas[data-mode="1"] .s2-context-col{opacity:1;transform:none}
  .s2-context-tools{height:39px;display:flex;align-items:center;justify-content:center;gap:8px}
  .s2-context-tools span{width:32px;height:32px;border-radius:11px;background:#151516;display:grid;place-items:center;color:#d8bd6f}
  .s2-context-tools svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .s2-note{position:relative;min-height:126px;padding:20px 15px 16px;border-radius:3px 3px 10px 4px;background:#d8bd6f;color:#282114;box-shadow:0 9px 24px rgba(0,0,0,.34);transform:rotate(1.4deg);display:flex;flex-direction:column;justify-content:center;gap:8px;font-family:"Segoe Print","Bradley Hand",cursive}
  .s2-note::before{content:"";position:absolute;inset:0;background:rgba(255,255,255,.18);opacity:0;border-radius:inherit}
  .s2-note.is-reading::before{animation:s2NoteRead .85s ease-in-out 2}
  .s2-note span{font-size:.7rem;line-height:1.3}.s2-note strong{position:relative;width:max-content;font-size:1rem;line-height:1.1}
  .s2-note strong::after{content:"";position:absolute;left:-2px;right:-4px;top:55%;height:2px;background:#282114;transform:scaleX(0);transform-origin:left;transition:transform .45s ease}
  .s2-note.is-used strong::after{transform:scaleX(1)}
  @keyframes s2NoteRead{0%,100%{opacity:0}50%{opacity:1}}

  .s2-playback{position:absolute;right:9px;top:50%;transform:translateY(-50%);width:38px;height:38px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:#151516;color:#f5f3ee;display:grid;place-items:center;cursor:pointer;z-index:10;transition:background .2s ease,transform .2s ease}
  .s2-playback:hover{background:#222225}.s2-playback:focus-visible{outline:2px solid #d8bd6f;outline-offset:3px}.s2-playback:active{transform:translateY(-50%) scale(.94)}
