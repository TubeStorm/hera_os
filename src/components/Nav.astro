---
import { nav, site, withBase } from '../data/site';
const current = Astro.url.pathname;
const isActive = (href: string) => current.replace(/\/$/, '').endsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-50">
  <div class="container-page">
    <nav
      class="mt-4 flex items-center justify-between rounded-pill border border-line bg-[color:var(--surface)]/80 px-4 py-2.5 backdrop-blur-xl sm:px-5"
      aria-label="Primary"
    >
      <a href={withBase('')} class="group flex items-center gap-2.5 pl-1 text-sm font-semibold tracking-tight">
        <span class="grid h-7 w-7 place-items-center rounded-lg bg-ink text-[13px] font-bold text-paper">F</span>
        <span class="hidden sm:inline">{site.name}</span>
      </a>

      <div class="flex items-center gap-1">
        {
          nav.map((item) => (
            <a
              href={withBase(item.href)}
              class:list={[
                'rounded-pill px-3 py-1.5 text-sm transition-colors duration-200',
                isActive(item.href) ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={withBase('contact/')}
          class="ml-1 hidden rounded-pill bg-ink px-4 py-1.5 text-sm font-medium text-paper transition-transform duration-300 ease-smooth hover:-translate-y-px sm:inline-block"
        >
          Get in touch
        </a>
      </div>
    </nav>
  </div>
</header>
