---
import { nav, withBase } from '../data/site';
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  // Home ('') must match exactly; inner pages match by suffix.
  return href === '' ? current === target : current === target;
};
---

<!-- The top inset lives on the STICKY element itself (pt-4 on the header), not
     as a margin on the inner nav. A margin there collapsed out through the
     header and moved the header box in flow, so once the header stuck at
     top:0 the pill went flush with the viewport edge. Padding is part of the
     sticky box and cannot collapse, so the pill floats at the same distance
     from the top before and during scroll. -->
<header class="sticky top-0 z-50 pt-4">
  <div class="container-page">
    <nav
      class="flex items-center justify-between rounded-pill border border-line bg-[color:var(--surface)]/80 px-4 py-2.5 backdrop-blur-xl sm:px-5"
      aria-label="Primary"
    >
      <a href={withBase('')} class="group flex shrink-0 items-center gap-2.5 pl-1 text-sm font-semibold tracking-tight">
        <picture class="block shrink-0">
          <source srcset={withBase('images/hera/logo/hera-logo-1254.webp')} type="image/webp" />
          <img
            src={withBase('images/hera/logo/hera-logo-1254.png')}
            alt="HERA OS"
            width="28"
            height="28"
            class="h-7 w-7 shrink-0 rounded-lg bg-[#0c0c10] object-contain p-1"
          />
        </picture>
        <span class="hidden sm:inline">HERA OS</span>
      </a>

      <div class="nav-links flex min-w-0 flex-1 items-center justify-start gap-1 overflow-x-auto sm:justify-end">
        {
          nav.map((item) => (
            <a
              href={withBase(item.href)}
              class:list={[
                'shrink-0 whitespace-nowrap rounded-pill px-3 py-1.5 text-sm transition-colors duration-200',
                isActive(item.href) ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<style>
  /* Mobile: too many nav destinations to fit one row without wrapping or
     clipping (e.g. "Ubisoft Work" + "Contact" at once). Scroll horizontally
     inside the pill rather than wrapping labels to two lines or letting
     later items run off-canvas. Scrollbar hidden for a clean pill edge. */
  .nav-links {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }
</style>
