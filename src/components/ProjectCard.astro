---
import type { Project } from '../data/site';
import { withBase } from '../data/site';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;
---

<a
  href={withBase(project.href)}
  class="card card-hover reveal group block overflow-hidden rounded-card"
  style={`transition-delay:${index * 60}ms`}
>
  <div class="p-3">
    <ImagePlaceholder label={project.accentImage} ratio="wide" class="border-line" />
  </div>
  <div class="flex flex-col gap-4 p-6 pt-3 sm:p-7 sm:pt-4">
    <div class="flex items-center justify-between gap-4">
      <p class="eyebrow">{project.eyebrow}</p>
      <span class="text-xs text-faint">{project.year}</span>
    </div>
    <div>
      <h3 class="text-h3 font-semibold tracking-tight">{project.title}</h3>
      <p class="mt-2 text-[0.98rem] leading-relaxed text-muted">{project.summary}</p>
    </div>
    <div class="mt-1 flex flex-wrap items-center gap-2">
      {project.tags.map((t) => <span class="chip text-xs">{t}</span>)}
    </div>
    <span class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
      Read case study
      <svg
        class="transition-transform duration-300 ease-smooth group-hover:translate-x-1"
        width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </div>
</a>
