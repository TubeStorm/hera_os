---
interface Props {
  kind?: 'quote' | 'note';
}
const { kind = 'quote' } = Astro.props;
---

<figure
  class="relative rounded-card border border-line bg-[color:var(--surface)] p-8 sm:p-10"
  style="box-shadow: var(--shadow-card);"
>
  <span
    class="absolute left-0 top-8 h-[calc(100%-4rem)] w-[3px] rounded-full"
    style="background: var(--accent);"
    aria-hidden="true"></span>
  <blockquote class="pl-6">
    <p class:list={[kind === 'quote' ? 'text-h3' : 'text-lead', 'font-medium tracking-tight text-ink']}>
      <slot />
    </p>
    <slot name="cite" />
  </blockquote>
</figure>
