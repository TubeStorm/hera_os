---
import BaseLayout from './BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import Button from '../components/Button.astro';

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  title: string; // browser title
  eyebrow: string;
  heading: string;
  subtitle: string;
  heroLabel: string;
  meta: MetaItem[];
  seoDescription?: string;
}

const { title, eyebrow, heading, subtitle, heroLabel, meta, seoDescription } = Astro.props;
---

<BaseLayout title={title} description={seoDescription ?? subtitle}>
  <article>
    <!-- Header -->
    <header class="container-page pb-10 pt-16 sm:pt-20">
      <a
        href="../"
        class="mb-8 inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        All work
      </a>

      <p class="eyebrow mb-5">{eyebrow}</p>
      <h1 class="max-w-4xl text-h1 font-semibold tracking-tight">{heading}</h1>
      <p class="mt-5 max-w-2xl text-lead text-muted">{subtitle}</p>

      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-line pt-8 sm:grid-cols-4">
        {
          meta.map((m) => (
            <div>
              <dt class="text-xs uppercase tracking-[0.12em] text-faint">{m.label}</dt>
              <dd class="mt-1.5 text-sm font-medium text-ink">{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <!-- Hero image -->
    <div class="container-page">
      <ImagePlaceholder label={heroLabel} ratio="wide" />
    </div>

    <!-- Body -->
    <div class="container-prose section">
      <slot />
    </div>

    <!-- Footer CTA -->
    <div class="container-page">
      <div class="card flex flex-col items-start justify-between gap-6 rounded-card p-8 sm:flex-row sm:items-center sm:p-10">
        <div>
          <p class="text-h3 font-semibold tracking-tight">Want the full walkthrough?</p>
          <p class="mt-2 text-muted">Happy to talk through the decisions, trade-offs, and what I&rsquo;d do next.</p>
        </div>
        <div class="flex gap-3">
          <Button href="contact/" variant="primary">Get in touch</Button>
          <Button href="work/" variant="ghost">More work</Button>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
