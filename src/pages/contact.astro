---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Get in touch with Favour Diokpo.">
  <section class="section">
    <div class="container-page grid gap-14 lg:grid-cols-2 lg:gap-20">
      <!-- Left: pitch -->
      <div class="reveal">
        <p class="eyebrow mb-5">Contact</p>
        <h1 class="text-h1 font-semibold tracking-tight">Let&rsquo;s make your AI product trustworthy.</h1>
        <p class="prose-hera mt-6">
          Whether you&rsquo;re building an agentic product, untangling a workflow, or rebuilding an
          internal tool people avoid — I&rsquo;d like to hear about it. The best first message is a
          sentence about what feels hard to trust right now.
        </p>

        <div class="mt-8 space-y-4">
          <a
            href={`mailto:${site.email}`}
            class="card card-hover flex items-center justify-between gap-4 rounded-card p-5"
          >
            <span>
              <span class="block text-xs uppercase tracking-[0.12em] text-faint">Email</span>
              <span class="mt-0.5 block text-sm font-medium text-ink">{site.email}</span>
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-muted" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
          {
            site.socials.filter((s) => !s.href.startsWith('mailto:')).map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="card card-hover flex items-center justify-between gap-4 rounded-card p-5"
              >
                <span>
                  <span class="block text-xs uppercase tracking-[0.12em] text-faint">Social</span>
                  <span class="mt-0.5 block text-sm font-medium text-ink">{s.label}</span>
                </span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-muted" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
            ))
          }
        </div>
        <p class="mt-6 text-sm text-faint">{site.location}</p>
      </div>

      <!-- Right: form (static; wire to a handler — see note) -->
      <div class="reveal" style="transition-delay:80ms">
        <form
          class="card rounded-card p-7 sm:p-8"
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
        >
          <div class="space-y-5">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium">Name</label>
              <input
                id="name" name="name" type="text" required autocomplete="name"
                class="w-full rounded-xl border border-line bg-[color:var(--paper)] px-4 py-2.5 text-sm outline-none transition focus:border-ink"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium">Email</label>
              <input
                id="email" name="email" type="email" required autocomplete="email"
                class="w-full rounded-xl border border-line bg-[color:var(--paper)] px-4 py-2.5 text-sm outline-none transition focus:border-ink"
                placeholder="you@company.com"
              />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium">What feels hard to trust?</label>
              <textarea
                id="message" name="message" rows="5" required
                class="w-full resize-y rounded-xl border border-line bg-[color:var(--paper)] px-4 py-2.5 text-sm outline-none transition focus:border-ink"
                placeholder="A sentence or two about the product or workflow…"
              ></textarea>
            </div>
          </div>

          <button
            type="submit"
            class="btn btn-primary mt-6 w-full"
          >
            Send message
          </button>
          <p class="mt-3 text-center text-xs text-faint">
            This form opens your email client. TODO: wire to Formspree / Web3Forms for inline submission (see README).
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
