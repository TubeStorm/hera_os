---
// Contact: the nav already said what this page is. Just the channels.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';

const channels = [
  { label: 'Email', href: contact.email.href, display: contact.email.display, external: false },
  { label: 'LinkedIn', href: contact.linkedin.href, display: contact.linkedin.display, external: true },
  { label: 'GitHub', href: contact.github.href, display: contact.github.display, external: true },
];
---

<BaseLayout title="Contact" description="Reach Favour Diokpo.">
  <section class="section">
    <div class="container-prose">
      <div class="divide-y divide-line">
        {
          channels.map((c) => (
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class="group flex items-baseline justify-between gap-6 py-6"
            >
              <span class="text-xs uppercase tracking-[0.14em] text-faint">{c.label}</span>
              <span class="text-lead font-medium text-ink transition-colors group-hover:text-muted">{c.display}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
