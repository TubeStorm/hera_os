---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import { withBase, contact } from '../data/site';
import { heraMedia } from '../data/lineage';

const loop = [
  { step: 'a messy thought', note: 'start rough, that is the point' },
  { step: 'a room', note: 'the conversation, kept' },
  { step: 'an Objective', note: 'what you actually meant' },
  { step: 'a roadmap', note: 'generated, not filled in' },
  { step: 'a goal', note: '' },
  { step: 'a task, executed', note: 'real runs, in parallel' },
  { step: 'an artifact', note: 'versioned, on disk' },
  { step: 'your review', note: 'approve, or send it back' },
  { step: 'the roadmap moves', note: 'because work happened' },
  { step: 'workflows that transform thoughts into things.', note: '' },
];

const discoveries = [
  {
    id: 'void',
    title: 'The Void',
    body: 'You do not begin by naming a project or filling out a setup form. You start with intent and when HERA finds a real objective inside it, the conversation becomes a roadmap.\n\nStructure comes after meaning, not before it.',
  },
  {
    id: 'composer',
    title: 'The transforming composer',
    body: 'One composer stays with you throughout the entire workflow. It becomes a question, guards your permission, lets you review, and make decisions the moment it matters most.\n\nHERA brings the next action to you.',
  },
  {
    id: 'roadmap',
    title: 'The living roadmap',
    body: 'Approve the result and HERA advances the task, the goal, and the roadmap. The plan changes because the work progressed, not because someone remembered to rewrite a status document.',
  },
];
---

<BaseLayout description="HERA turns messy founder thinking into an executable AI roadmap.">
  <section class="flex min-h-[92vh] flex-col items-center justify-center text-center">
    <div class="container-prose animate-rise">
      <p class="eyebrow justify-center">HERA OS</p>
      <h1 class="mt-6 text-display font-semibold tracking-tightest">
        Messy founder thinking, turned into an executable AI roadmap.
      </h1>
    </div>
    <div class="mt-16 animate-rise text-faint" style="animation-delay: 400ms" aria-hidden="true">↓</div>
  </section>

  <section id="lit-section" class="relative" style="height: 240vh">
    <div class="sticky top-0 flex h-screen items-center">
      <p id="lit-text" class="container-prose text-h2 font-semibold leading-snug sm:text-h1">
        AI builds faster than you can think now. Pieces of your product appear in minutes, scattered across chats you will never find again.

        Generation stopped being the bottleneck.

        Keeping the work coherent is.
      </p>
      <button id="lit-next" class="scroll-gate" type="button" aria-label="Continue to the HERA demo">
        <span>↓</span>
      </button>
    </div>
  </section>

  <section id="video-section" class="gate-screen">
    <div class="video-shell container-page">
      <MediaFrame missing={heraMedia.heroRecording.missing} class="reveal" />
    </div>
    <button id="video-next" class="scroll-gate is-visible" type="button" aria-label="Continue to how HERA works">
      <span>↓</span>
    </button>
  </section>

  <section id="loop-section" class="gate-screen loop-screen">
    <div class="loop-layout container-page">
      <div class="loop-copy-column">
        <ol id="loop-list" class="space-y-3">
          {
            loop.map((item, index) => (
              <li class="loop-step flex items-baseline gap-4 transition duration-500" data-loop-index={index}>
                <span class="text-h3 font-semibold sm:text-h2">{item.step}</span>
                {item.note && <span class="loop-note hidden text-sm text-muted sm:inline">{item.note}</span>}
              </li>
            ))
          }
        </ol>
      </div>

      <div id="flow-stage" class="flow-stage" data-step="0" aria-live="polite">
        <div class="hera-canvas">
          <div class="thought-cloud" aria-hidden="true">
            <div class="thought thought-a">
              <div class="thought-drift user-bubble-mini">ok so i need something that keeps client stuff from disappearing everywhere</div>
            </div>
            <div class="thought thought-b">
              <div class="thought-drift user-bubble-mini">maybe emails and voice notes? idk it should know what they actually asked for</div>
            </div>
            <div class="thought thought-c">
              <div class="thought-drift user-bubble-mini">i keep agreeing to things and then realizing that was not even confirmed lol</div>
            </div>
            <div class="thought thought-d">
              <div class="thought-drift user-bubble-mini">make it simple though i do not want another giant project manager</div>
            </div>
          </div>

          <div class="objective-flow" aria-hidden="true">
            <div class="objective-line">
              <span class="objective-line-fill"></span>
              <span class="objective-arrow">↓</span>
            </div>
            <div class="objective-card">
              <div class="objective-card-head">
                <span>Objective</span>
                <span class="objective-check">✓</span>
              </div>
              <p>Turn scattered client messages into clear, user-approved work without creating commitments from uncertain language.</p>
              <div class="objective-calibrating"><span></span></div>
            </div>
          </div>

          <div class="roadmap-zone" aria-hidden="true">
            <div class="roadmap-objective-mini">
              <span>Objective</span>
              <strong>Build a trustworthy client-request workflow</strong>
            </div>

            <div class="roadmap-first-control">
              <button type="button" tabindex="-1">
                <span class="roadmap-control-icon">+</span>
                <span>New goal</span>
              </button>
              <button class="plan-project-button" type="button" tabindex="-1">
                <span class="roadmap-control-icon">✦</span>
                <span>Plan project</span>
              </button>
            </div>

            <div class="roadmap-nodes">
              <div class="goal-node goal-node-1">
                <span class="goal-state">Ready</span>
                <strong>Define the trustworthy request system</strong>
                <span class="goal-meta">8 tasks</span>
                <span class="goal-strip"><i></i><i></i><i></i><i></i></span>
              </div>
              <span class="goal-connector"></span>
              <span class="goal-count">8</span>
              <div class="goal-node goal-node-2">
                <span class="goal-state">Queued</span>
                <strong>Build the BriefRelay experience</strong>
                <span class="goal-meta">16 tasks</span>
                <span class="goal-strip"><i></i><i></i><i></i><i></i></span>
              </div>
            </div>
          </div>

          <div class="goal-workspace" aria-hidden="true">
            <div class="goal-workspace-head">
              <div>
                <span class="workspace-kicker">Goal</span>
                <strong>Build the BriefRelay experience</strong>
                <p>4 lanes, 16 tasks, 4 active run slots</p>
              </div>
              <button type="button" tabindex="-1">▶ Play goal</button>
            </div>
            <div class="task-matrix">
              {Array.from({ length: 4 }).map((_, lane) => (
                <div class="task-lane" data-lane={lane + 1}>
                  <span class="lane-label">Lane {lane + 1}</span>
                  <div class="task-chip task-done">
                    <span>Done</span>
                    <strong>{['Collect request examples', 'Define request states', 'Design approval boundary', 'Create test set'][lane]}</strong>
                  </div>
                  <span class="task-link"></span>
                  <div class="task-chip task-progress">
                    <span>In progress</span>
                    <strong>{['Group message context', 'Detect uncertain work', 'Build review composer', 'Run product checks'][lane]}</strong>
                    <i class="task-loader"></i>
                  </div>
                  <span class="task-link"></span>
                  <div class="task-chip task-review">
                    <span>Waiting for review</span>
                    <strong>{['Preserve client history', 'Resolve contradictions', 'Create approved task', 'Verify request flow'][lane]}</strong>
                  </div>
                  <span class="task-link"></span>
                  <div class="task-chip task-queued">
                    <span>Queued</span>
                    <strong>{['Prepare handoff', 'Draft reply support', 'Polish experience', 'Package release'][lane]}</strong>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="artifact-scene" aria-hidden="true">
            <div class="artifact-roadmap-ghost">
              <div class="ghost-goal"><span></span><span></span><span></span><span></span></div>
              <i></i>
              <div class="ghost-goal"><span></span><span></span><span></span><span></span></div>
            </div>
            <div class="final-artifact-card">
              <div class="artifact-preview">
                <svg viewBox="0 0 720 390" role="img" aria-label="BriefRelay product experience">
                  <defs>
                    <linearGradient id="artifact-bg" x1="0" x2="1" y1="0" y2="1">
                      <stop offset="0" stop-color="#291e46" />
                      <stop offset="1" stop-color="#0b0910" />
                    </linearGradient>
                    <radialGradient id="artifact-glow" cx="50%" cy="32%" r="65%">
                      <stop offset="0" stop-color="#a98bff" stop-opacity=".42" />
                      <stop offset="1" stop-color="#a98bff" stop-opacity="0" />
                    </radialGradient>
                  </defs>
                  <rect width="720" height="390" rx="26" fill="url(#artifact-bg)" />
                  <rect width="720" height="390" rx="26" fill="url(#artifact-glow)" />
                  <rect x="54" y="42" width="612" height="306" rx="24" fill="#0d0c10" fill-opacity=".92" />
                  <text x="92" y="94" fill="#f4f1ea" font-family="Inter, sans-serif" font-size="18" font-weight="700">BriefRelay</text>
                  <text x="92" y="124" fill="#a7a1b0" font-family="Inter, sans-serif" font-size="11">One client thread, interpreted before work becomes real.</text>
                  <rect x="92" y="156" width="536" height="56" rx="18" fill="#f3f0e9" />
                  <text x="116" y="182" fill="#111014" font-family="Inter, sans-serif" font-size="11">Could you make the logo bigger?</text>
                  <text x="116" y="199" fill="#716b77" font-family="Inter, sans-serif" font-size="9">Confirmed request</text>
                  <rect x="92" y="226" width="536" height="56" rx="18" fill="#17151d" />
                  <text x="116" y="252" fill="#eee9f5" font-family="Inter, sans-serif" font-size="11">Maybe later we can rewrite the About page.</text>
                  <text x="116" y="269" fill="#9d88d1" font-family="Inter, sans-serif" font-size="9">Discussed, not confirmed</text>
                  <rect x="444" y="296" width="184" height="34" rx="17" fill="#f3f0e9" />
                  <text x="478" y="318" fill="#111014" font-family="Inter, sans-serif" font-size="10" font-weight="700">Review interpretation</text>
                </svg>
              </div>
              <div class="artifact-card-body">
                <div>
                  <span class="artifact-type">Experience</span>
                  <strong>BriefRelay request review</strong>
                  <p>1 image, Version 2</p>
                </div>
                <button id="review-chip" class="review-chip" type="button" tabindex="-1">Waiting for review</button>
              </div>
              <div class="artifact-progress-line"><span></span></div>
            </div>
          </div>

          <div id="flow-cursor" class="flow-cursor" aria-hidden="true">
            <svg viewBox="0 0 24 32">
              <path d="M2.4 1.9 20.2 19c.8.8.2 2.1-.9 2.1h-7l3.7 7.4-4.2 2.1-3.7-7.5-4.7 4.8c-.7.7-1.9.2-1.9-.8V3c0-1 .9-1.6 1.9-1.1Z" fill="#fff" stroke="#111" stroke-width="1.7" stroke-linejoin="round" />
            </svg>
            <span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="discoveries-section" class="section border-t border-line">
    <div class="container-page grid gap-14 md:grid-cols-3">
      {
        discoveries.map((d) => (
          <div class="reveal">
            <h2 class="text-h3 font-semibold">{d.title}</h2>
            {d.body.split('\n\n').map((para) => (
              <p class="mt-3 leading-relaxed text-muted">{para}</p>
            ))}
            <a
              href={withBase(`work/hera/#${d.id}`)}
              class="mt-4 inline-block text-sm text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
            >
              See it dissected →
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="container-prose reveal">
      <p class="text-lead text-muted">
        I'm <strong class="font-semibold text-ink">Favour Diokpo</strong>. I've been building tools like this for
        myself since 2023: planners, timers, behavior systems, context keepers. Years before there was a company
        for them to belong to. <strong class="font-semibold text-ink">HERA is where they converged.</strong>
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-6 text-sm">
        <a
          href={withBase('work/lineage/')}
          class="text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
        >
          The Long Build →
        </a>
        <a href={contact.github.href} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-ink">
          GitHub
        </a>
        <a href={contact.email.href} class="text-muted transition-colors hover:text-ink">
          {contact.email.display}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #lit-text :global(.w) {
    color: var(--faint);
    opacity: 0.25;
    transition: color 0.25s linear, opacity 0.25s linear;
  }

  #lit-text :global(.w.near) {
    color: var(--faint);
    opacity: 1;
  }

  #lit-text :global(.w.lit) {
    color: var(--ink);
    opacity: 1;
  }

  .gate-screen {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .video-shell {
    width: 100%;
    display: grid;
    place-items: center;
  }

  .scroll-gate {
    position: absolute;
    left: 50%;
    bottom: 34px;
    z-index: 30;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 10px);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(.2,.82,.2,1);
  }

  .scroll-gate.is-visible {
    opacity: 0.72;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .scroll-gate:hover {
    opacity: 1;
  }

  .scroll-gate span {
    display: block;
    font-size: 22px;
    animation: gatePoint 1.8s ease-in-out infinite;
  }

  @keyframes gatePoint {
    0%, 100% { transform: translateY(-2px); }
    50% { transform: translateY(6px); }
  }

  .loop-screen {
    background: var(--paper, transparent);
  }

  .loop-layout {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(320px, 0.72fr) minmax(560px, 1.28fr);
    align-items: center;
    gap: clamp(42px, 6vw, 112px);
  }

  .loop-copy-column {
    min-width: 0;
  }

  .loop-step {
    opacity: 0.16;
    transform: translateX(0);
    transition: opacity 0.46s ease, transform 0.56s cubic-bezier(.2,.82,.2,1);
  }

  .loop-step.active {
    opacity: 1;
    transform: translateX(12px);
  }

  .loop-step.done {
    opacity: 0.36;
  }

  .loop-step .loop-note {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .loop-step.active .loop-note {
    opacity: 1;
  }

  .flow-stage {
    width: 100%;
    min-width: 0;
  }

  .hera-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 1.34 / 1;
    min-height: 620px;
    overflow: hidden;
    border-radius: 34px;
    background: #000;
    color: #f4f1ea;
    box-shadow: 0 38px 90px rgba(0,0,0,.18);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .thought-cloud {
    transition: opacity 0.6s ease;
  }

  .objective-flow,
  .roadmap-zone,
  .goal-workspace,
  .artifact-scene {
    position: absolute;
    inset: 0;
  }

  .thought {
    position: absolute;
    width: min(390px, 44%);
    transition: left 0.9s cubic-bezier(.2,.82,.2,1), top 0.9s cubic-bezier(.2,.82,.2,1), transform 0.9s cubic-bezier(.2,.82,.2,1), opacity 0.6s ease;
  }

  .thought-drift {
    animation: thoughtDrift 12s ease-in-out infinite alternate;
  }

  .thought-b .thought-drift { animation-delay: -3.2s; }
  .thought-c .thought-drift { animation-delay: -6.8s; }
  .thought-d .thought-drift { animation-delay: -1.7s; }

  @keyframes thoughtDrift {
    from { transform: translateY(-7px); }
    to { transform: translateY(10px); }
  }

  .user-bubble-mini {
    padding: 13px 17px;
    border-radius: 22px 22px 7px 22px;
    background: rgba(244,241,234,.96);
    color: #090909;
    font-size: 15px;
    line-height: 1.42;
    letter-spacing: -.012em;
    box-shadow: 0 10px 30px rgba(0,0,0,.24);
  }

  .thought-a { left: 8%; top: 14%; transform: rotate(-6deg); }
  .thought-b { left: 49%; top: 24%; transform: rotate(4deg); }
  .thought-c { left: 16%; top: 55%; transform: rotate(5deg); }
  .thought-d { left: 52%; top: 67%; transform: rotate(-4deg); }

  .objective-flow,
  .roadmap-zone,
  .goal-workspace,
  .artifact-scene {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease, transform 0.7s cubic-bezier(.2,.82,.2,1);
  }

  .objective-flow {
    transform: translateY(32px);
  }

  .objective-line {
    position: absolute;
    left: 50%;
    top: 41%;
    width: 1px;
    height: 92px;
    background: rgba(244,241,234,.09);
  }

  .objective-line-fill {
    position: absolute;
    inset: 0;
    transform-origin: top;
    background: linear-gradient(180deg, rgba(236,210,141,.15), #ecd28d);
    animation: objectiveDraw 1.8s ease-in-out infinite;
  }

  .objective-arrow {
    position: absolute;
    left: 50%;
    bottom: -15px;
    transform: translateX(-50%);
    color: #ecd28d;
    font-size: 15px;
  }

  @keyframes objectiveDraw {
    0% { transform: scaleY(.08); opacity: .2; }
    70%, 100% { transform: scaleY(1); opacity: 1; }
  }

  .objective-card {
    position: absolute;
    left: 50%;
    top: 60%;
    width: min(560px, 68%);
    padding: 18px 20px 17px;
    border-radius: 20px;
    transform: translateX(-50%);
    background: rgba(255,255,255,.055);
  }

  .objective-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(244,241,234,.52);
    font-size: 11px;
  }

  .objective-check {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border-radius: 5px;
    background: rgba(174,224,189,.14);
    color: #aee0bd;
    font-size: 11px;
  }

  .objective-card p {
    margin: 12px 0 0;
    color: rgba(244,241,234,.88);
    font-size: 15px;
    line-height: 1.48;
  }

  .objective-calibrating {
    height: 2px;
    margin-top: 16px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255,255,255,.06);
  }

  .objective-calibrating span {
    display: block;
    width: 28%;
    height: 100%;
    background: #ecd28d;
    animation: calibrating 1.5s ease-in-out infinite;
  }

  @keyframes calibrating {
    from { transform: translateX(-120%); }
    to { transform: translateX(450%); }
  }

  .roadmap-objective-mini {
    position: absolute;
    left: 50%;
    top: 11%;
    width: min(590px, 74%);
    transform: translateX(-50%);
    text-align: left;
  }

  .roadmap-objective-mini span {
    display: block;
    color: rgba(244,241,234,.34);
    font-size: 10px;
  }

  .roadmap-objective-mini strong {
    display: block;
    margin-top: 7px;
    color: rgba(244,241,234,.9);
    font-size: 16px;
    font-weight: 620;
  }

  .roadmap-first-control {
    position: absolute;
    left: 50%;
    top: 47%;
    width: 214px;
    height: 214px;
    display: grid;
    grid-template-rows: 1fr 1fr;
    transform: translate(-50%, -50%);
    overflow: hidden;
    border-radius: 28px;
    background: rgba(255,255,255,.055);
    transition: opacity 0.6s ease, transform 0.8s cubic-bezier(.2,.82,.2,1);
  }

  .roadmap-first-control button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 0;
    background: transparent;
    color: rgba(244,241,234,.6);
    font-size: 12px;
  }

  .roadmap-first-control button + button {
    background: rgba(236,210,141,.055);
    color: #ecd28d;
  }

  .roadmap-control-icon {
    font-size: 15px;
  }

  .roadmap-nodes {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 43%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 78px 34px 78px minmax(0, 1fr);
    align-items: center;
    opacity: 0;
    transform: translateY(30px) scale(.96);
    transition: opacity 0.7s ease, transform 0.85s cubic-bezier(.2,.82,.2,1);
  }

  .goal-node {
    min-height: 142px;
    padding: 17px 18px 14px;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(236,210,141,.035), rgba(236,210,141,.11));
  }

  .goal-node strong {
    display: block;
    margin-top: 13px;
    color: #f4f1ea;
    font-size: 14px;
    line-height: 1.35;
  }

  .goal-state,
  .goal-meta {
    color: rgba(236,210,141,.72);
    font-size: 9px;
  }

  .goal-meta {
    display: block;
    margin-top: 10px;
    color: rgba(244,241,234,.34);
  }

  .goal-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    margin-top: 13px;
  }

  .goal-strip i {
    height: 3px;
    border-radius: 99px;
    background: rgba(236,210,141,.7);
  }

  .goal-connector {
    height: 1px;
    background: linear-gradient(90deg, rgba(236,210,141,.65), rgba(236,210,141,.16));
  }

  .goal-count {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(236,210,141,.14);
    color: #ecd28d;
    font-size: 10px;
  }

  .goal-workspace {
    inset: 7% 5%;
    transform: translateY(38px) scale(.98);
  }

  .goal-workspace-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .goal-workspace-head strong {
    display: block;
    margin-top: 7px;
    font-size: 18px;
  }

  .goal-workspace-head p {
    margin: 6px 0 0;
    color: rgba(244,241,234,.36);
    font-size: 10px;
  }

  .goal-workspace-head button {
    padding: 10px 14px;
    border: 0;
    border-radius: 14px;
    background: rgba(236,210,141,.12);
    color: #ecd28d;
    font-size: 10px;
  }

  .workspace-kicker {
    color: rgba(244,241,234,.34);
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .task-matrix {
    margin-top: 30px;
    display: grid;
    gap: 15px;
  }

  .task-lane {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr);
    align-items: center;
    gap: 7px;
  }

  .lane-label {
    color: rgba(244,241,234,.28);
    font-size: 8px;
