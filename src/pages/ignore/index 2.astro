  }

  .artifact-progress-line span {
    display: block;
    width: 38%;
    height: 100%;
    background: #9fc7ff;
    animation: reviewWait 1.8s ease-in-out infinite;
  }

  @keyframes reviewWait {
    from { transform: translateX(-120%); }
    to { transform: translateX(360%); }
  }

  .flow-cursor {
    position: absolute;
    z-index: 50;
    left: 50%;
    top: 50%;
    width: 25px;
    height: 34px;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: left 0.82s cubic-bezier(.2,.82,.2,1), top 0.82s cubic-bezier(.2,.82,.2,1), opacity 0.28s ease, transform 0.18s ease;
    filter: drop-shadow(0 5px 8px rgba(0,0,0,.45));
  }

  .flow-cursor svg {
    width: 100%;
    height: 100%;
  }

  .flow-cursor span {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 24px;
    height: 24px;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 50%;
    opacity: 0;
    transform: scale(.35);
  }

  .flow-cursor.is-clicking {
    transform: translate(-50%, -50%) scale(.88);
  }

  .flow-cursor.is-clicking span {
    animation: cursorClick .55s ease-out;
  }

  @keyframes cursorClick {
    from { opacity: .7; transform: scale(.25); }
    to { opacity: 0; transform: scale(1.6); }
  }

  .flow-stage[data-step="1"] .thought-a { left: 26%; top: 15%; transform: rotate(-1deg); }
  .flow-stage[data-step="1"] .thought-b { left: 26%; top: 31%; transform: rotate(1deg); }
  .flow-stage[data-step="1"] .thought-c { left: 26%; top: 48%; transform: rotate(-1deg); }
  .flow-stage[data-step="1"] .thought-d { left: 26%; top: 65%; transform: rotate(1deg); }

  .flow-stage[data-step="2"] .thought-a { left: 29%; top: 15%; transform: translate(0, 0) rotate(-1deg); }
  .flow-stage[data-step="2"] .thought-b { left: 30.5%; top: 17.5%; transform: rotate(.5deg); }
  .flow-stage[data-step="2"] .thought-c { left: 32%; top: 20%; transform: rotate(1.5deg); }
  .flow-stage[data-step="2"] .thought-d { left: 33.5%; top: 22.5%; transform: rotate(2.5deg); }

  .flow-stage[data-step="2"] .objective-flow {
    opacity: 1;
    transform: translateY(0);
  }

  .flow-stage[data-step="3"] .thought {
    top: -9%;
    opacity: .16;
  }


  .flow-stage[data-step="4"] .thought-cloud,
  .flow-stage[data-step="5"] .thought-cloud,
  .flow-stage[data-step="6"] .thought-cloud,
  .flow-stage[data-step="7"] .thought-cloud,
  .flow-stage[data-step="8"] .thought-cloud,
  .flow-stage[data-step="9"] .thought-cloud {
    opacity: 0;
  }

  .flow-stage[data-step="3"] .objective-flow {
    opacity: 0;
    transform: translateY(-100px);
  }

  .flow-stage[data-step="3"] .roadmap-zone,
  .flow-stage[data-step="4"] .roadmap-zone,
  .flow-stage[data-step="5"] .roadmap-zone {
    opacity: 1;
    transform: translateY(0);
  }

  .flow-stage[data-step="3"] .flow-cursor {
    left: 53%;
    top: 60%;
    opacity: 1;
  }

  .flow-stage[data-step="4"] .roadmap-first-control,
  .flow-stage[data-step="5"] .roadmap-first-control {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.72);
  }

  .flow-stage[data-step="4"] .roadmap-nodes,
  .flow-stage[data-step="5"] .roadmap-nodes {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .flow-stage[data-step="5"].is-task-open .goal-workspace {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .flow-stage[data-step="5"] .roadmap-zone.is-task-open {
    opacity: 0;
    transform: translateY(-25px) scale(.98);
  }

  .flow-stage[data-step="5"] .flow-cursor {
    left: 22%;
    top: 48%;
    opacity: 1;
  }

  .flow-stage[data-step="5"].is-task-open .flow-cursor {
    opacity: 0;
  }

  .flow-stage[data-step="6"] .artifact-scene,
  .flow-stage[data-step="7"] .artifact-scene,
  .flow-stage[data-step="8"] .artifact-scene,
  .flow-stage[data-step="9"] .artifact-scene {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .flow-stage[data-step="7"] .review-chip,
  .flow-stage[data-step="8"] .review-chip {
    box-shadow: 0 0 0 7px rgba(95,140,205,.05), 0 0 34px rgba(95,140,205,.18);
  }

  .flow-stage[data-step="7"] .flow-cursor {
    left: 74%;
    top: 66%;
    opacity: 1;
  }

  .flow-stage[data-step="8"] .artifact-roadmap-ghost,
  .flow-stage[data-step="9"] .artifact-roadmap-ghost {
    opacity: .62;
    transform: translateY(0);
  }

  .flow-stage[data-step="8"] .final-artifact-card,
  .flow-stage[data-step="9"] .final-artifact-card {
    top: 58%;
  }

  .flow-stage[data-step="9"] .flow-cursor {
    left: 74%;
    top: 71%;
    opacity: 1;
  }

  .flow-stage[data-step="9"].is-approved .review-chip {
    background: rgba(174,224,189,.15);
    color: #aee0bd;
    box-shadow: 0 0 0 8px rgba(174,224,189,.05), 0 0 44px rgba(174,224,189,.26);
  }

  .flow-stage[data-step="9"].is-approved .artifact-progress-line span {
    width: 100%;
    background: #aee0bd;
    animation: none;
  }

  .flow-stage[data-step="9"].is-approved .final-artifact-card {
    box-shadow: 0 0 0 1px rgba(174,224,189,.1), 0 30px 90px rgba(84,146,102,.2);
    transform: translate(-50%, -50%) scale(1.015);
  }

  .flow-stage[data-step="9"].is-approved .ghost-goal span {
    background: #aee0bd;
    box-shadow: 0 0 12px rgba(174,224,189,.24);
  }

  @media (max-width: 1100px) {
    .loop-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .loop-copy-column {
      position: absolute;
      left: 28px;
      top: 28px;
      z-index: 4;
      max-width: 56%;
    }

    .loop-step:not(.active) {
      display: none;
    }

    .hera-canvas {
      min-height: 580px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #lit-text :global(.w),
    #lit-text :global(.w.near),
    .loop-step {
      opacity: 1 !important;
      color: var(--ink) !important;
      transform: none !important;
    }

    .thought-drift,
    .objective-line-fill,
    .objective-calibrating span,
    .task-loader,
    .artifact-progress-line span,
    .scroll-gate span {
      animation: none !important;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const litSection = document.getElementById('lit-section');
  const litText = document.getElementById('lit-text');
  const litNext = document.getElementById('lit-next');
  const videoSection = document.getElementById('video-section');
  const videoNext = document.getElementById('video-next');
  const loopSection = document.getElementById('loop-section');
  const discoveriesSection = document.getElementById('discoveries-section');
  const flowStage = document.getElementById('flow-stage');
  const flowCursor = document.getElementById('flow-cursor');
  const reviewChip = document.getElementById('review-chip');
  const steps = Array.from(document.querySelectorAll('.loop-step'));

  let words = [];
  let mode = 'free';
  let loopIndex = 0;
  let transitionRunning = false;
  let wheelTotal = 0;
  let wheelLockUntil = 0;
  let stageToken = 0;
  let touchStartY = 0;

  if (litText) {
    const parts = (litText.textContent ?? '').trim().split(/\s+/);
    litText.innerHTML = parts.map((word) => `<span class="w">${word}</span>`).join(' ');
    words = Array.from(litText.querySelectorAll('.w'));
  }

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  const progressIn = (element) => {
    const rect = element.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    return total <= 0 ? 0 : clamp(-rect.top / total, 0, 1);
  };

  const easeInOut = (value) => value < 0.5
    ? 4 * value * value * value
    : 1 - Math.pow(-2 * value + 2, 3) / 2;

  const scrollToPosition = (target, duration = 1250) => new Promise((resolve) => {
    const start = window.scrollY;
    const distance = target - start;
    const started = performance.now();
    transitionRunning = true;

    const frame = (now) => {
      const progress = clamp((now - started) / duration, 0, 1);
      window.scrollTo(0, start + distance * easeInOut(progress));
      if (progress < 1) {
        requestAnimationFrame(frame);
      } else {
        transitionRunning = false;
        resolve();
      }
    };

    requestAnimationFrame(frame);
  });

  const sectionTop = (element) => Math.round(element.getBoundingClientRect().top + window.scrollY);
  const litEnd = () => sectionTop(litSection) + litSection.offsetHeight - window.innerHeight;

  const setLoopState = (index) => {
    loopIndex = clamp(index, 0, steps.length - 1);
    stageToken += 1;
    const token = stageToken;

    steps.forEach((step, stepIndex) => {
      step.classList.toggle('active', stepIndex === loopIndex);
      step.classList.toggle('done', stepIndex < loopIndex);
    });

    flowStage.dataset.step = String(loopIndex);
    flowStage.classList.remove('is-approved', 'is-task-open');
    flowStage.querySelector('.roadmap-zone')?.classList.remove('is-task-open');
    flowCursor?.classList.remove('is-clicking');
    if (reviewChip) reviewChip.textContent = 'Waiting for review';

    if (loopIndex === 5) {
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowCursor?.classList.add('is-clicking');
      }, 560);
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowStage.querySelector('.roadmap-zone')?.classList.add('is-task-open');
        flowStage.classList.add('is-task-open');
        flowCursor?.classList.remove('is-clicking');
      }, 1050);
    }

    if (loopIndex === 9) {
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowCursor?.classList.add('is-clicking');
      }, 780);
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowCursor?.classList.remove('is-clicking');
        flowStage.classList.add('is-approved');
        if (reviewChip) reviewChip.textContent = 'Approved';
      }, 1320);
    }
  };

  const updateLit = () => {
    if (!litSection || !words.length) return;
    const progress = progressIn(litSection);
    const lit = Math.round(progress * 1.15 * words.length);
    const nearWindow = Math.ceil(words.length * 0.25);

    words.forEach((word, index) => {
      word.classList.toggle('lit', index < lit);
      word.classList.toggle('near', index >= lit && index < lit + nearWindow);
    });

    const ready = progress >= 0.985;
    litNext?.classList.toggle('is-visible', ready);
  };

  const goToLit = async () => {
    mode = 'lit';
    litNext?.classList.add('is-visible');
    await scrollToPosition(litEnd(), 1150);
  };

  const goToVideo = async () => {
    mode = 'video';
    litNext?.classList.remove('is-visible');
    await scrollToPosition(sectionTop(videoSection), 1400);
  };

  const goToLoop = async (index = 0) => {
    mode = 'loop';
    setLoopState(index);
    await scrollToPosition(sectionTop(loopSection), 1400);
  };

  const leaveLoop = async () => {
    mode = 'free';
    await scrollToPosition(sectionTop(discoveriesSection), 1200);
  };

  const handleLoopDelta = (delta) => {
    const now = performance.now();
    if (now < wheelLockUntil) return;

    wheelTotal += delta;
    if (Math.abs(wheelTotal) < 58) return;

    const direction = wheelTotal > 0 ? 1 : -1;
    wheelTotal = 0;
    wheelLockUntil = now + 620;

    if (direction < 0 && loopIndex === 0) {
      goToVideo();
      return;
    }

    if (direction > 0 && loopIndex === steps.length - 1) {
      leaveLoop();
      return;
    }

    setLoopState(loopIndex + direction);
  };

  window.addEventListener('scroll', updateLit, { passive: true });

  window.addEventListener('wheel', (event) => {
    if (reduced) return;

    if (transitionRunning) {
      event.preventDefault();
      return;
    }

    const y = window.scrollY;
    const nearLitEnd = y >= litEnd() - 100 && y < sectionTop(videoSection) - 20;

    if (mode === 'free' && event.deltaY > 0 && nearLitEnd) {
      event.preventDefault();
      mode = 'lit';
      litNext?.classList.add('is-visible');
      scrollToPosition(litEnd(), 420);
      return;
    }

    const nearDiscoveries = y <= sectionTop(discoveriesSection) + 120 && y > sectionTop(loopSection) + 80;

    if (mode === 'free' && event.deltaY < 0 && nearDiscoveries) {
      event.preventDefault();
      goToLoop(steps.length - 1);
      return;
    }

    if (mode === 'lit') {
      if (event.deltaY > 0) {
        event.preventDefault();
      } else {
        mode = 'free';
        litNext?.classList.remove('is-visible');
      }
      return;
    }

    if (mode === 'video') {
      event.preventDefault();
      if (event.deltaY < -18) goToLit();
      return;
    }

    if (mode === 'loop') {
      event.preventDefault();
      handleLoopDelta(event.deltaY);
    }
  }, { passive: false });

  window.addEventListener('touchstart', (event) => {
    touchStartY = event.touches[0]?.clientY ?? 0;
  }, { passive: true });

  window.addEventListener('touchend', (event) => {
    if (reduced) return;
    const endY = event.changedTouches[0]?.clientY ?? touchStartY;
    const delta = touchStartY - endY;

    if (mode === 'video') {
      if (delta < -35) goToLit();
      return;
    }

    if (mode === 'loop' && Math.abs(delta) > 35) {
      handleLoopDelta(delta);
    }
  }, { passive: true });

  litNext?.addEventListener('click', goToVideo);
  videoNext?.addEventListener('click', () => goToLoop(0));

  if (reduced) {
    words.forEach((word) => word.classList.add('lit'));
    steps.forEach((step) => step.classList.add('active'));
    flowStage.dataset.step = '9';
    flowStage.classList.add('is-approved');
    if (reviewChip) reviewChip.textContent = 'Approved';
  } else {
    setLoopState(0);
    updateLit();
  }
</script>
