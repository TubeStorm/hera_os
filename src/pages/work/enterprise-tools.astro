import { withBase } from '../../data/site';
const target = withBase('work/ubisoft/');
---
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>
      This page has moved. <a href={target}>Go to Ubisoft Work</a>.
    </p>
  </body>
</html>
