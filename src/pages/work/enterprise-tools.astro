---
// release/public-portfolio-2026-08-19
// This page replaces the full enterprise-tools case study for the public release.
// The complete case study implementation remains on portfolio-week1 and will be
// published once Favour has reviewed and approved it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';
---

<BaseLayout
  title="Ubisoft Work — Favour Diokpo"
  description="Selected Ubisoft work is proprietary. Redacted case studies are being prepared."
>
  <section class="section">
    <div class="container-prose">
      <div class="reveal flex flex-col gap-6 border-b border-line pb-10">
        <p class="eyebrow">Ubisoft — Senior UX Specialist</p>
        <h1 class="text-h1 font-semibold tracking-tight">Enterprise Systems</h1>
        <p class="text-lead text-muted max-w-xl">
          Selected Ubisoft work is proprietary. Redacted case studies are being
          prepared. Additional work can be discussed during interview.
        </p>
      </div>

      <div class="reveal mt-12 rounded-card border border-dashed border-line p-8 text-sm text-muted leading-relaxed max-w-xl">
        <p>
          I spent five years as <strong class="text-ink">Senior UX Specialist</strong> at
          <strong class="text-ink">Ubisoft Montréal</strong>, working on internal enterprise
          platforms used by 1,000+ people across Production, HR, and Finance. The case studies
          cover three distinct workstreams: resource planning, remote-work approval governance,
          and capacity visibility.
        </p>
        <p class="mt-4">
          Screenshots and product details are under NDA. A redacted presentation is available
          on request.
        </p>
      </div>

      <div class="reveal mt-10 flex gap-4 flex-wrap">
        <a href={withBase('contact/')} class="btn btn-primary">Request a walkthrough</a>
        <a href={withBase('about/')} class="btn btn-ghost">Read about my process</a>
      </div>
    </div>
  </section>
</BaseLayout>
