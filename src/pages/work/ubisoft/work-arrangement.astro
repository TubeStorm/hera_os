---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../data/site';
---

<BaseLayout
  title="Work Arrangement — Designing a company-wide remote-work approval system"
  description="Work Arrangement case study: five structured approval flows for Ubisoft's company-wide remote-work request platform."
>
  <article>
    <!-- Header -->
    <header class="container-page pb-10 pt-16 sm:pt-20">
      <a
        href={withBase('work/ubisoft/')}
        class="mb-8 inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        Ubisoft Work
      </a>

      <p class="eyebrow mb-5">Case 02 — Hybrid Workplace Platform</p>
      <h1 class="max-w-4xl text-h1 font-semibold tracking-tight">
        Designing a company-wide remote-work approval system
      </h1>
      <p class="mt-5 max-w-2xl text-lead text-muted">
        The tool only knew approve or reject. Escalations, corrections, and send-backs happened over email — or not at all. This is the story of turning a broken conversation between roles into five explicit flows with real accountability.
      </p>

      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-[color:var(--line)] pt-8 sm:grid-cols-4">
        <div>
          <dt class="text-xs uppercase tracking-[0.12em] text-faint">Role</dt>
          <dd class="mt-1.5 text-sm font-medium text-ink">Senior UX Specialist</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.12em] text-faint">Context</dt>
          <dd class="mt-1.5 text-sm font-medium text-ink">Ubisoft, Montréal</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.12em] text-faint">Timeline</dt>
          <dd class="mt-1.5 text-sm font-medium text-ink">May 2021 — Present</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.12em] text-faint">Roles researched</dt>
          <dd class="mt-1.5 text-sm font-medium text-ink">4 org levels</dd>
        </div>
      </dl>
    </header>

    <!-- Placeholder body -->
    <div class="container-prose section">
      <div class="rounded-xl border border-dashed border-[color:var(--line)] p-10 text-center">
        <p class="text-sm uppercase tracking-[0.12em] text-faint">Case study in preparation</p>
        <p class="mt-3 max-w-sm mx-auto text-muted text-sm leading-relaxed">
          The Work Arrangement case study will live here. Multi-role workflow, decision ownership, policy constraints, five flows.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
