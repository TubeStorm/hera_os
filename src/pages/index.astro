---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import OpeningFailureSequence from '../components/OpeningFailureSequence.astro';
import { withBase, contact } from '../data/site';
import { heraMedia } from '../data/lineage';

const loop = [
  { step: 'a messy thought', note: 'start rough, that is the point' },
  { step: 'a room', note: 'the conversation, kept' },
  { step: 'an Objective', note: 'what you are really trying to accomplish' },
  { step: 'a roadmap', note: 'the strategy, generated around your intent' },
  { step: 'a goal', note: 'an outcome you can prove complete' },
  { step: 'a task', note: 'bounded work, sequenced or parallel' },
  { step: 'artifacts you review', note: 'approve them, revise them, or send them back' },
  { step: 'thoughts transformed into things.', note: 'the result, with the whole path intact' },
];

const discoveries = [
  {
    id: 'void',
    title: 'The Void',
    body: 'You do not begin by naming a project or filling out a setup form. You start with intent and when HERA finds a real objective inside it, the conversation becomes a roadmap.\n\nStructure comes after meaning, not before it.',
  },
  {
    id: 'composer',
    title: 'The transforming composer',
    body: 'One composer stays with you throughout the entire workflow. It becomes a question, guards your permission, lets you review, and make decisions the moment it matters most.\n\nHERA brings the next action to you.',
  },
  {
    id: 'roadmap',
    title: 'The living roadmap',
    body: 'Approve the result and HERA advances the task, the goal, and the roadmap. The plan changes because the work progressed, not because someone remembered to rewrite a status document.',
  },
];
---

<BaseLayout description="HERA turns messy founder thinking into an executable AI roadmap.">
  <OpeningFailureSequence />

  <section id="video-section" class="section gate-screen video-screen">
    <div class="video-gate-stack">
      <div class="container-page video-shell">
        <MediaFrame video={heraMedia.heroRecording.video} class="reveal" />
      </div>
      <button id="video-next" class="scroll-gate is-visible" type="button" aria-label="Continue to how HERA works">
        <span>↓</span>
      </button>
    </div>
  </section>

  <section id="loop-section" class="gate-screen loop-screen">
    <div class="loop-layout">
      <div class="loop-copy-column">
        <ol id="loop-list" class="space-y-3">
          {
            loop.map((item, index) => (
              <li class="loop-step flex items-baseline gap-4 transition duration-500" data-loop-index={index}>
                <span class="text-h3 font-semibold sm:text-h2">{item.step}</span>
                {item.note && <span class="loop-note hidden text-sm text-muted sm:inline">{item.note}</span>}
              </li>
            ))
          }
        </ol>
      </div>

      <div id="flow-stage" class="flow-stage" data-step="0" aria-live="polite">
        <div class="hera-canvas">
          <div class="thought-cloud" aria-hidden="true">
            <div class="thought thought-a">
              <div class="thought-drift user-bubble-mini">i keep thinking about why old broken statues still feel alive</div>
            </div>
            <div class="thought thought-b">
              <div class="thought-drift user-bubble-mini">maybe the missing arms and faces make us imagine the rest? idk</div>
            </div>
            <div class="thought thought-c">
              <div class="thought-drift user-bubble-mini">i want to write about it but not make it sound like homework</div>
            </div>
            <div class="thought thought-d">
              <div class="thought-drift user-bubble-mini">could that strange sculpture image be the article header too</div>
            </div>
          </div>

          <div class="objective-flow" aria-hidden="true">
            <div class="objective-line">
              <span class="objective-line-fill"></span>
              <span class="objective-arrow">↓</span>
            </div>
            <div class="objective-card">
              <div class="objective-card-head">
                <span>Objective</span>
                <span class="objective-check">✓</span>
              </div>
              <p>Write a clear article about why broken ancient sculptures can still feel alive.</p>
              <div class="objective-calibrating"><span></span></div>
            </div>
          </div>

          <div class="roadmap-zone" aria-hidden="true">
            <div class="roadmap-objective-mini">
              <span>Objective</span>
              <strong>Write a clear article about why broken sculptures still feel alive</strong>
            </div>

            <div class="roadmap-first-control">
              <button type="button" tabindex="-1">
                <span class="roadmap-control-icon">+</span>
                <span>New goal</span>
              </button>
              <button class="plan-project-button" type="button" tabindex="-1">
                <span class="roadmap-control-icon">✦</span>
                <span>Plan project</span>
              </button>
            </div>

            <div class="roadmap-nodes">
              <div class="goal-node goal-node-1">
                <span class="goal-state">Ready</span>
                <strong>Research why broken sculptures feel alive</strong>
                <span class="goal-meta">16 tasks</span>
                <span class="goal-strip"><i></i><i></i><i></i><i></i></span>
              </div>
              <span class="goal-connector"></span>
              <span class="goal-count">16</span>
              <div class="goal-node goal-node-2">
                <span class="goal-state">Queued</span>
                <strong>Write and finish the sculpture article</strong>
                <span class="goal-meta">16 tasks</span>
                <span class="goal-strip"><i></i><i></i><i></i><i></i></span>
              </div>
            </div>
          </div>

          <div class="goal-workspace" aria-hidden="true">
            <div class="goal-workspace-head">
              <div>
                <span class="workspace-kicker">Goal</span>
                <strong>Write and finish the sculpture article</strong>
                <p>4 lanes, 16 tasks, 4 active run slots</p>
              </div>
              <button type="button" tabindex="-1">▶ Play goal</button>
            </div>
            <div class="task-matrix">
              {Array.from({ length: 4 }).map((_, lane) => (
                <div class="task-lane" data-lane={lane + 1}>
                  <span class="lane-label">Lane {lane + 1}</span>
                  <div class="task-chip task-done">
                    <span>Done</span>
                    <strong>{['Choose the article question', 'Collect sculpture examples', 'Outline the article', 'Choose the header image'][lane]}</strong>
                  </div>
                  <span class="task-link"></span>
                  <div class="task-chip task-progress">
                    <span>In progress</span>
                    <strong>{['Research the history', 'Explain why missing parts matter', 'Draft the opening', 'Build the header visual'][lane]}</strong>
                    <i class="task-loader"></i>
                  </div>
                  <span class="task-link"></span>
                  <div class="task-chip task-review">
                    <span>Waiting for parallel</span>
                    <strong>{['Connect the idea to imagination', 'Check names and facts', 'Shape the main argument', 'Match the image to the article'][lane]}</strong>
                  </div>
                  <span class="task-link"></span>
                  <div class="task-chip task-queued">
                    <span>Queued</span>
                    <strong>{['Write the final section', 'Add the examples', 'Edit for clear language', 'Package the article'][lane]}</strong>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="artifact-scene" aria-hidden="true">
            <div class="final-artifact-card" aria-label="Open Broken sculptures article header, Version 1, waiting for review" role="button">
              <div class="artifact-preview artifact-image-preview">
                <img
                  src={withBase('images/sculpture_base_2072_scanline.png')}
                  alt="Broken sculptures article header"
                  loading="eager"
                />
                <div class="artifact-preview-copy">
                  <strong>Broken sculptures article header</strong>
                  <small>Article header image</small>
                </div>
              </div>
              <div class="artifact-card-bottom">
                <div class="artifact-chips">
                  <span>Images 1</span>
                  <span>PNG</span>
                </div>
                <div class="artifact-version">
                  <small>Version 1</small>
                  <button id="review-chip" class="review-chip" type="button" tabindex="-1">Waiting for review</button>
                </div>
              </div>
              <div class="artifact-progress-line"><span></span></div>
            </div>
          </div>

          <div id="flow-cursor" class="flow-cursor" aria-hidden="true">
            <svg viewBox="0 0 24 32">
              <path d="M2.4 1.9 20.2 19c.8.8.2 2.1-.9 2.1h-7l3.7 7.4-4.2 2.1-3.7-7.5-4.7 4.8c-.7.7-1.9.2-1.9-.8V3c0-1 .9-1.6 1.9-1.1Z" fill="#fff" stroke="#111" stroke-width="1.7" stroke-linejoin="round" />
            </svg>
            <span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="discoveries-section" class="section border-t border-line">
    <div class="container-page grid gap-14 md:grid-cols-3">
      {
        discoveries.map((d) => (
          <div class="reveal">
            <h2 class="text-h3 font-semibold">{d.title}</h2>
            {d.body.split('\n\n').map((para) => (
              <p class="mt-3 leading-relaxed text-muted">{para}</p>
            ))}
            <a
              href={withBase(`work/hera/#${d.id}`)}
              class="mt-4 inline-block text-sm text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
            >
              See it dissected →
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="container-prose reveal">
      <p class="text-lead text-muted">
        I'm <strong class="font-semibold text-ink">Favour Diokpo</strong>. I've been building tools like this for
        myself since 2023: planners, timers, behavior systems, context keepers. Years before there was a company
        for them to belong to. <strong class="font-semibold text-ink">HERA is where they converged.</strong>
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-6 text-sm">
        <a
          href={withBase('work/lineage/')}
          class="text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
        >
          The Long Build →
        </a>
        <a href={contact.github.href} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-ink">
          GitHub
        </a>
        <a href={contact.email.href} class="text-muted transition-colors hover:text-ink">
          {contact.email.display}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    overscroll-behavior-y: none;
  }

  .gate-screen {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .video-screen.section {
    padding-block: 0;
  }

  .video-gate-stack {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 2.6vh, 28px);
  }

  .scroll-gate {
    position: relative;
    z-index: 30;
    width: 48px;
    height: 48px;
    flex: none;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.38s cubic-bezier(.2,.82,.2,1);
  }

  .scroll-gate.is-visible {
    opacity: 0.78;
    pointer-events: auto;
    transform: translateY(0);
  }

  .scroll-gate:hover {
    opacity: 1;
  }

  .scroll-gate span {
    display: block;
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    text-shadow: 0 0 18px rgba(255,255,255,.13);
    animation: gatePoint 1.8s ease-in-out infinite;
  }

  @keyframes gatePoint {
    0%, 100% { transform: translateY(-2px); }
    50% { transform: translateY(7px); }
  }

  .loop-screen {
    background: var(--paper, transparent);
  }

  .loop-layout {
    width: min(1880px, calc(100vw - 72px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(560px, 0.82fr) minmax(760px, 1.18fr);
    align-items: center;
    gap: clamp(64px, 6vw, 132px);
  }

  .loop-copy-column {
    min-width: 0;
    width: 100%;
  }

  #loop-list {
    width: min(100%, 720px);
  }

  .loop-step {
    opacity: 0.16;
    transform: translateX(0);
    transition: opacity 0.46s ease, transform 0.56s cubic-bezier(.2,.82,.2,1);
  }

  .loop-step > span:first-child {
    flex: none;
    white-space: nowrap;
  }

  .loop-step.active {
    opacity: 1;
    transform: translateX(12px);
  }

  .loop-step.done {
    opacity: 0.36;
  }

  .loop-step .loop-note {
    min-width: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .loop-step.active .loop-note {
    opacity: 1;
    white-space: nowrap;
  }

  .flow-stage {
    width: 100%;
    min-width: 0;
  }

  .hera-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 1.42 / 1;
    min-height: 660px;
    overflow: hidden;
    border-radius: 34px;
    background: #000;
    color: #f4f1ea;
    box-shadow: 0 38px 90px rgba(0,0,0,.18);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .thought-cloud {
    transition: opacity 0.6s ease;
  }

  .objective-flow,
  .roadmap-zone,
  .goal-workspace,
  .artifact-scene {
    position: absolute;
    inset: 0;
  }

  .thought {
    position: absolute;
    width: min(390px, 44%);
    transition: left 0.9s cubic-bezier(.2,.82,.2,1), top 0.9s cubic-bezier(.2,.82,.2,1), transform 0.9s cubic-bezier(.2,.82,.2,1), opacity 0.6s ease;
  }

  .thought-drift {
    animation: thoughtDrift 12s ease-in-out infinite alternate;
  }

  .thought-b .thought-drift { animation-delay: -3.2s; }
  .thought-c .thought-drift { animation-delay: -6.8s; }
  .thought-d .thought-drift { animation-delay: -1.7s; }

  @keyframes thoughtDrift {
    from { transform: translateY(-7px); }
    to { transform: translateY(10px); }
  }

  .user-bubble-mini {
    padding: 13px 17px;
    border-radius: 22px 22px 7px 22px;
    background: rgba(244,241,234,.96);
    color: #090909;
    font-size: 15px;
    line-height: 1.42;
    letter-spacing: -.012em;
    box-shadow: 0 10px 30px rgba(0,0,0,.24);
  }

  .thought-a { left: 8%; top: 14%; transform: rotate(-6deg); }
  .thought-b { left: 49%; top: 24%; transform: rotate(4deg); }
  .thought-c { left: 16%; top: 55%; transform: rotate(5deg); }
  .thought-d { left: 52%; top: 67%; transform: rotate(-4deg); }

  .objective-flow,
  .roadmap-zone,
  .goal-workspace,
  .artifact-scene {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease, transform 0.7s cubic-bezier(.2,.82,.2,1);
  }

  .objective-flow {
    transform: translateY(32px);
  }

  .objective-line {
    position: absolute;
    left: 50%;
    top: 41%;
    width: 1px;
    height: 92px;
    background: rgba(244,241,234,.09);
  }

  .objective-line-fill {
    position: absolute;
    inset: 0;
    transform-origin: top;
    background: linear-gradient(180deg, rgba(236,210,141,.15), #ecd28d);
    animation: objectiveDraw 1.8s ease-in-out infinite;
  }

  .objective-arrow {
    position: absolute;
    left: 50%;
    bottom: -15px;
    transform: translateX(-50%);
    color: #ecd28d;
    font-size: 15px;
  }

  @keyframes objectiveDraw {
    0% { transform: scaleY(.08); opacity: .2; }
    70%, 100% { transform: scaleY(1); opacity: 1; }
  }

  .objective-card {
    position: absolute;
    left: 50%;
    top: 60%;
    width: min(560px, 68%);
    padding: 18px 20px 17px;
    border-radius: 20px;
    transform: translateX(-50%);
    background: rgba(255,255,255,.055);
  }

  .objective-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(244,241,234,.52);
    font-size: 11px;
  }

  .objective-check {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border-radius: 5px;
    background: rgba(174,224,189,.14);
    color: #aee0bd;
    font-size: 11px;
  }

  .objective-card p {
    margin: 12px 0 0;
    color: rgba(244,241,234,.88);
    font-size: 15px;
    line-height: 1.48;
  }

  .objective-calibrating {
    height: 2px;
    margin-top: 16px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255,255,255,.06);
  }

  .objective-calibrating span {
    display: block;
    width: 28%;
    height: 100%;
    background: #ecd28d;
    animation: calibrating 1.5s ease-in-out infinite;
  }

  @keyframes calibrating {
    from { transform: translateX(-120%); }
    to { transform: translateX(450%); }
  }

  .roadmap-objective-mini {
    position: absolute;
    left: 50%;
    top: 11%;
    width: min(590px, 74%);
    transform: translateX(-50%);
    text-align: left;
  }

  .roadmap-objective-mini span {
    display: block;
    color: rgba(244,241,234,.34);
    font-size: 10px;
  }

  .roadmap-objective-mini strong {
    display: block;
    margin-top: 7px;
    color: rgba(244,241,234,.9);
    font-size: 16px;
    font-weight: 620;
  }

  .roadmap-first-control {
    position: absolute;
    left: 50%;
    top: 47%;
    width: 214px;
    height: 214px;
    display: grid;
    grid-template-rows: 1fr 1fr;
    transform: translate(-50%, -50%);
    overflow: hidden;
    border-radius: 28px;
    background: rgba(255,255,255,.055);
    transition: opacity 0.6s ease, transform 0.8s cubic-bezier(.2,.82,.2,1);
  }

  .roadmap-first-control button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 0;
    background: transparent;
    color: rgba(244,241,234,.6);
    font-size: 12px;
  }

  .roadmap-first-control button + button {
    background: rgba(236,210,141,.055);
    color: #ecd28d;
  }

  .roadmap-control-icon {
    font-size: 15px;
  }

  .roadmap-nodes {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 43%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 72px 34px minmax(0, 1fr);
    align-items: center;
    opacity: 0;
    transform: translateY(30px) scale(.96);
    transition: opacity 0.7s ease, transform 0.85s cubic-bezier(.2,.82,.2,1);
  }

  .goal-node {
    min-width: 0;
    min-height: 142px;
    padding: 17px 18px 14px;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(236,210,141,.035), rgba(236,210,141,.11));
  }

  .goal-node strong {
    display: block;
    margin-top: 13px;
    color: #f4f1ea;
    font-size: 14px;
    line-height: 1.35;
  }

  .goal-state,
  .goal-meta {
    color: rgba(236,210,141,.72);
    font-size: 9px;
  }

  .goal-meta {
    display: block;
    margin-top: 10px;
    color: rgba(244,241,234,.34);
  }

  .goal-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    margin-top: 13px;
  }

  .goal-strip i {
    height: 3px;
    border-radius: 99px;
    background: rgba(236,210,141,.7);
  }

  .goal-connector {
    height: 1px;
    background: linear-gradient(90deg, rgba(236,210,141,.65), rgba(236,210,141,.16));
  }

  .goal-count {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(236,210,141,.14);
    color: #ecd28d;
    font-size: 10px;
  }

  .goal-workspace {
    inset: 7% 5%;
    transform: translateY(38px) scale(.98);
  }

  .goal-workspace-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .goal-workspace-head strong {
    display: block;
    margin-top: 7px;
    font-size: 18px;
  }

  .goal-workspace-head p {
    margin: 6px 0 0;
    color: rgba(244,241,234,.36);
    font-size: 10px;
  }

  .goal-workspace-head button {
    padding: 10px 14px;
    border: 0;
    border-radius: 14px;
    background: rgba(236,210,141,.12);
    color: #ecd28d;
    font-size: 10px;
  }

  .workspace-kicker {
    color: rgba(244,241,234,.34);
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .task-matrix {
    margin-top: 30px;
    display: grid;
    gap: 15px;
  }

  .task-lane {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr);
    align-items: center;
    gap: 7px;
  }

  .lane-label {
    color: rgba(244,241,234,.28);
    font-size: 8px;
  }

  .task-chip {
    position: relative;
    min-height: 78px;
    padding: 11px 12px;
    overflow: hidden;
    border-radius: 15px;
    background: rgba(255,255,255,.05);
  }

  .task-chip span {
    display: block;
    font-size: 8px;
  }

  .task-chip strong {
    display: block;
    margin-top: 8px;
    font-size: 10px;
    line-height: 1.25;
  }

  .task-done { background: rgba(114,183,133,.13); }
  .task-done span { color: #aee0bd; }
  .task-progress { background: rgba(216,189,111,.11); }
  .task-progress span { color: #d8bd6f; }
  .task-review { background: rgba(157,129,220,.12); }
  .task-review span { color: #bda8ef; }
  .task-queued span { color: rgba(244,241,234,.28); }

  .task-link {
    height: 1px;
    background: rgba(244,241,234,.1);
  }

  .task-loader {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(236,210,141,.12) 48%, transparent 66%);
    transform: translateX(-100%);
    animation: taskLoad 1.8s linear infinite;
  }

  @keyframes taskLoad {
    to { transform: translateX(100%); }
  }

  .artifact-scene {
    transform: translateY(34px) scale(.98);
  }

  .final-artifact-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(700px, 80%);
    padding: 12px;
    border-radius: 26px;
    transform: translate(-50%, -50%);
    background: rgba(255,255,255,.06);
    transition: box-shadow 0.7s ease, transform 0.7s cubic-bezier(.2,.82,.2,1);
  }

  .artifact-preview {
    position: relative;
    height: 440px;
    overflow: hidden;
    border-radius: 19px;
    background:
      radial-gradient(circle at 50% 35%, rgba(158,129,254,.2), transparent 42%),
      linear-gradient(145deg, #1a122a, #09080d 72%);
  }

  .artifact-image-preview img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .artifact-preview-copy {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    pointer-events: none;
    text-shadow: 0 2px 18px rgba(0,0,0,.75);
  }

  .artifact-preview-copy strong {
    font-size: 13px;
  }

  .artifact-preview-copy small {
    color: rgba(244,241,234,.55);
    font-size: 9px;
  }

  .artifact-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 12px 4px 2px;
  }

  .artifact-chips,
  .artifact-version {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .artifact-chips span {
    padding: 5px 8px;
    border-radius: 999px;
    background: rgba(255,255,255,.045);
    color: rgba(244,241,234,.48);
    font-size: 8px;
  }

  .artifact-version > small {
    color: rgba(244,241,234,.38);
    font-size: 8px;
  }

  .review-chip {
    flex: none;
    padding: 7px 10px;
    border: 0;
    border-radius: 999px;
    background: rgba(95,140,205,.17);
    color: #9fc7ff;
    font-size: 8px;
    transition: background 0.4s ease, color 0.4s ease, box-shadow 0.5s ease;
  }

  .artifact-progress-line {
    height: 2px;
    margin: 9px 4px 2px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255,255,255,.05);
  }

  .artifact-progress-line span {
    display: block;
    width: 38%;
    height: 100%;
    background: #9fc7ff;
    animation: reviewWait 1.8s ease-in-out infinite;
  }

  @keyframes reviewWait {
    from { transform: translateX(-120%); }
    to { transform: translateX(360%); }
  }

  .flow-cursor {
    position: absolute;
    z-index: 50;
    left: 50%;
    top: 50%;
    width: 25px;
    height: 34px;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: left 0.82s cubic-bezier(.2,.82,.2,1), top 0.82s cubic-bezier(.2,.82,.2,1), opacity 0.28s ease, transform 0.18s ease;
    filter: drop-shadow(0 5px 8px rgba(0,0,0,.45));
  }

  .flow-cursor svg {
    width: 100%;
    height: 100%;
  }

  .flow-cursor span {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 24px;
    height: 24px;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 50%;
    opacity: 0;
    transform: scale(.35);
  }

  .flow-cursor.is-clicking {
    transform: translate(-50%, -50%) scale(.88);
  }

  .flow-cursor.is-clicking span {
    animation: cursorClick .55s ease-out;
  }

  @keyframes cursorClick {
    from { opacity: .7; transform: scale(.25); }
    to { opacity: 0; transform: scale(1.6); }
  }

  /* 0 — messy thought */
  .flow-stage[data-step="1"] .thought-a { left: 26%; top: 15%; transform: rotate(-1deg); }
  .flow-stage[data-step="1"] .thought-b { left: 26%; top: 31%; transform: rotate(1deg); }
  .flow-stage[data-step="1"] .thought-c { left: 26%; top: 48%; transform: rotate(-1deg); }
  .flow-stage[data-step="1"] .thought-d { left: 26%; top: 65%; transform: rotate(1deg); }

  /* 2 — Objective */
  .flow-stage[data-step="2"] .thought-a { left: 29%; top: 15%; transform: rotate(-1deg); }
  .flow-stage[data-step="2"] .thought-b { left: 30.5%; top: 17.5%; transform: rotate(.5deg); }
  .flow-stage[data-step="2"] .thought-c { left: 32%; top: 20%; transform: rotate(1.5deg); }
  .flow-stage[data-step="2"] .thought-d { left: 33.5%; top: 22.5%; transform: rotate(2.5deg); }
  .flow-stage[data-step="2"] .objective-flow { opacity: 1; transform: translateY(0); }

  /* 3 — Roadmap */
  .flow-stage[data-step="3"] .thought { top: -9%; opacity: .16; }
  .flow-stage[data-step="3"] .objective-flow { opacity: 0; transform: translateY(-100px); }
  .flow-stage[data-step="3"] .roadmap-zone,
  .flow-stage[data-step="4"] .roadmap-zone { opacity: 1; transform: translateY(0); }
  .flow-stage[data-step="3"] .flow-cursor { left: 53%; top: 60%; opacity: 1; }

  /* 4 — Goal. The cursor clicks Plan project before the goal nodes are created. */
  .flow-stage[data-step="4"] .thought-cloud,
  .flow-stage[data-step="5"] .thought-cloud,
  .flow-stage[data-step="6"] .thought-cloud,
  .flow-stage[data-step="7"] .thought-cloud { opacity: 0; }
  .flow-stage[data-step="4"] .roadmap-zone { opacity: 1; transform: translateY(0); }
  .flow-stage[data-step="4"] .flow-cursor { left: 53%; top: 60%; opacity: 1; }
  .flow-stage[data-step="4"].is-plan-clicked .roadmap-first-control {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.72);
  }
  .flow-stage[data-step="4"].is-plan-clicked .roadmap-nodes {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .flow-stage[data-step="4"].is-plan-clicked .flow-cursor { opacity: 0; }

  /* 5 — Task */
  .flow-stage[data-step="5"] .roadmap-zone { opacity: 1; transform: translateY(0); }
  .flow-stage[data-step="5"] .roadmap-first-control { opacity: 0; transform: translate(-50%, -50%) scale(.72); }
  .flow-stage[data-step="5"] .roadmap-nodes { opacity: 1; transform: translateY(0) scale(1); }
  .flow-stage[data-step="5"] .flow-cursor { left: 22%; top: 48%; opacity: 1; }
  .flow-stage[data-step="5"].is-task-open .goal-workspace { opacity: 1; transform: translateY(0) scale(1); }
  .flow-stage[data-step="5"] .roadmap-zone.is-task-open { opacity: 0; transform: translateY(-25px) scale(.98); }
  .flow-stage[data-step="5"].is-task-open .flow-cursor { opacity: 0; }

  /* 6 — Artifact waiting for review */
  .flow-stage[data-step="6"] .artifact-scene,
  .flow-stage[data-step="7"] .artifact-scene { opacity: 1; transform: translateY(0) scale(1); }

  /* 7 — Approved transformation */
  .flow-stage[data-step="7"] .flow-cursor { left: 78%; top: 77%; opacity: 1; }
  .flow-stage[data-step="7"].is-approved .review-chip {
    background: rgba(174,224,189,.15);
    color: #aee0bd;
    box-shadow: 0 0 0 8px rgba(174,224,189,.05), 0 0 44px rgba(174,224,189,.26);
  }
  .flow-stage[data-step="7"].is-approved .artifact-progress-line span {
    width: 100%;
    background: #aee0bd;
    animation: none;
  }
  .flow-stage[data-step="7"].is-approved .final-artifact-card {
    box-shadow: 0 0 0 1px rgba(174,224,189,.1), 0 30px 90px rgba(84,146,102,.2);
    transform: translate(-50%, -50%) scale(1.015);
  }

  @media (max-width: 1450px) {
    .loop-layout {
      width: min(1320px, calc(100vw - 56px));
      grid-template-columns: minmax(470px, .86fr) minmax(650px, 1.14fr);
      gap: 54px;
    }

    .hera-canvas {
      min-height: 610px;
    }

    .roadmap-nodes {
      left: 4%;
      right: 4%;
      grid-template-columns: minmax(0, 1fr) 52px 32px minmax(0, 1fr);
    }
  }

  @media (max-width: 1100px) {
    .loop-layout {
      grid-template-columns: 1fr;
      width: min(920px, calc(100vw - 40px));
      gap: 30px;
    }

    .loop-copy-column {
      position: absolute;
      left: 28px;
      top: 28px;
      z-index: 4;
      max-width: 68%;
    }

    .loop-step:not(.active) {
      display: none;
    }

    .hera-canvas {
      min-height: 580px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-step {
      opacity: 1 !important;
      color: var(--ink) !important;
      transform: none !important;
    }

    .thought-drift,
    .objective-line-fill,
    .objective-calibrating span,
    .task-loader,
    .artifact-progress-line span,
    .scroll-gate span {
      animation: none !important;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videoSection = document.getElementById('video-section');
  const videoNext = document.getElementById('video-next');
  const loopSection = document.getElementById('loop-section');
  const discoveriesSection = document.getElementById('discoveries-section');
  const flowStage = document.getElementById('flow-stage');
  const flowCursor = document.getElementById('flow-cursor');
  const reviewChip = document.getElementById('review-chip');
  const steps = Array.from(document.querySelectorAll('.loop-step'));

  let mode = 'intro';
  let loopIndex = 0;
  let transitionRunning = false;
  let wheelTotal = 0;
  let wheelLockUntil = 0;
  let stageToken = 0;
  let touchStartY = 0;
  let approvalReady = false;
  let hardLockY = null;
  let enforcingLock = false;
  let lastScrollY = window.scrollY;

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
  const sectionTop = (element) => Math.round(element.getBoundingClientRect().top + window.scrollY);
  const loopExitY = () => sectionTop(discoveriesSection ?? loopSection) + 24;

  const lockScrollAt = (position) => {
    hardLockY = Math.round(position);
  };

  const unlockScroll = () => {
    hardLockY = null;
  };

  const easeInOut = (value) => value < 0.5
    ? 4 * value * value * value
    : 1 - Math.pow(-2 * value + 2, 3) / 2;

  const scrollToPosition = (target, duration = 900) => new Promise((resolve) => {
    const start = window.scrollY;
    const distance = target - start;
    const started = performance.now();
    transitionRunning = true;
    unlockScroll();

    const frame = (now) => {
      const progress = clamp((now - started) / duration, 0, 1);
      window.scrollTo(0, start + distance * easeInOut(progress));
      if (progress < 1) {
        requestAnimationFrame(frame);
      } else {
        transitionRunning = false;
        wheelLockUntil = performance.now() + 260;
        resolve();
      }
    };

    requestAnimationFrame(frame);
  });

  const setLoopState = (index, { instant = false } = {}) => {
    loopIndex = clamp(index, 0, steps.length - 1);
    stageToken += 1;
    const token = stageToken;
    approvalReady = false;

    steps.forEach((step, stepIndex) => {
      step.classList.toggle('active', stepIndex === loopIndex);
      step.classList.toggle('done', stepIndex < loopIndex);
    });

    flowStage.dataset.step = String(loopIndex);
    flowStage.classList.remove('is-approved', 'is-task-open', 'is-plan-clicked');
    flowStage.querySelector('.roadmap-zone')?.classList.remove('is-task-open');
    flowCursor?.classList.remove('is-clicking');
    if (reviewChip) reviewChip.textContent = 'Waiting for review';


    if (loopIndex === 4) {
      wheelLockUntil = performance.now() + 1780;
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowCursor?.classList.add('is-clicking');
      }, 520);
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowCursor?.classList.remove('is-clicking');
        flowStage.classList.add('is-plan-clicked');
      }, 980);
    }

    if (loopIndex === 5) {
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowCursor?.classList.add('is-clicking');
      }, 520);
      window.setTimeout(() => {
        if (token !== stageToken) return;
        flowStage.querySelector('.roadmap-zone')?.classList.add('is-task-open');
        flowStage.classList.add('is-task-open');
        flowCursor?.classList.remove('is-clicking');
      }, 980);
    }

    if (loopIndex === 7) {
      if (instant) {
        flowStage.classList.add('is-approved');
        if (reviewChip) reviewChip.textContent = 'Approved';
        approvalReady = true;
      } else {
        wheelLockUntil = performance.now() + 1450;
        window.setTimeout(() => {
          if (token !== stageToken) return;
          flowCursor?.classList.add('is-clicking');
        }, 620);
        window.setTimeout(() => {
          if (token !== stageToken) return;
          flowCursor?.classList.remove('is-clicking');
          flowStage.classList.add('is-approved');
          if (reviewChip) reviewChip.textContent = 'Approved';
          approvalReady = true;
        }, 1120);
      }
    }
  };

  const goToVideo = async () => {
    mode = 'video';
    await scrollToPosition(sectionTop(videoSection), 760);
    lockScrollAt(sectionTop(videoSection));
  };

  const goToLoop = async (index = 0, options = {}) => {
    mode = 'loop';
    setLoopState(index, options);
    await scrollToPosition(sectionTop(loopSection), 760);
    lockScrollAt(sectionTop(loopSection));
  };

  const handleLoopDelta = (delta) => {
    const now = performance.now();
    if (now < wheelLockUntil) return;

    wheelTotal += delta;
    if (Math.abs(wheelTotal) < 52) return;

    const direction = wheelTotal > 0 ? 1 : -1;
    wheelTotal = 0;
    wheelLockUntil = now + 560;

    if (direction < 0 && loopIndex === 0) {
      goToVideo();
      return;
    }

    setLoopState(loopIndex + direction);
  };

  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    const videoTop = sectionTop(videoSection);

    // Only arm the video lock when the visitor actually crosses into it from
    // above (lastScrollY was still short of the threshold). A visitor who
    // just unlocked out of 'video' mode is typically resting AT videoTop —
    // checking "currently >= threshold" alone would immediately re-trap them
    // on their very next scroll-up tick.
    if (mode === 'intro' && !transitionRunning && lastScrollY < videoTop - 2 && y >= videoTop - 2) {
      mode = 'video';
      lockScrollAt(videoTop);
      window.scrollTo(0, videoTop);
    }
    lastScrollY = window.scrollY;

    if (
      !transitionRunning &&
      hardLockY !== null &&
      !enforcingLock &&
      Math.abs(window.scrollY - hardLockY) > 1
    ) {
      enforcingLock = true;
      window.scrollTo(0, hardLockY);
      requestAnimationFrame(() => {
        enforcingLock = false;
      });
    }
  }, { passive: true });

  window.addEventListener('wheel', (event) => {
    if (reduced) return;

    if (transitionRunning || performance.now() < wheelLockUntil) {
      event.preventDefault();
      return;
    }

    const y = window.scrollY;

    if (mode === 'intro') {
      return;
    }

    if (mode === 'free') {
      if (event.deltaY < 0 && y <= loopExitY()) {
        event.preventDefault();
        goToLoop(steps.length - 1, { instant: true });
      }
      return;
    }

    if (mode === 'video') {
      event.preventDefault();
      if (event.deltaY < -16) {
        mode = 'intro';
        unlockScroll();
      }
      return;
    }

    if (mode === 'loop') {
      if (event.deltaY > 0 && loopIndex === steps.length - 1 && approvalReady) {
        mode = 'free';
        unlockScroll();
        return;
      }
      event.preventDefault();
      handleLoopDelta(event.deltaY);
    }
  }, { passive: false });

  window.addEventListener('touchstart', (event) => {
    touchStartY = event.touches[0]?.clientY ?? 0;
  }, { passive: true });

  window.addEventListener('touchend', (event) => {
    if (reduced || transitionRunning) return;
    const endY = event.changedTouches[0]?.clientY ?? touchStartY;
    const delta = touchStartY - endY;

    if (mode === 'video') {
      if (delta < -35) {
        mode = 'intro';
        unlockScroll();
      }
      return;
    }

    if (mode === 'loop' && Math.abs(delta) > 35) {
      if (delta > 0 && loopIndex === steps.length - 1 && approvalReady) {
        mode = 'free';
        unlockScroll();
        return;
      }
      handleLoopDelta(delta);
    }
  }, { passive: true });

  videoNext?.addEventListener('click', () => goToLoop(0));

  const initialiseModeFromPosition = () => {
    const y = window.scrollY;
    if (y < sectionTop(videoSection) - 2) {
      mode = 'intro';
      unlockScroll();
    } else if (y < sectionTop(loopSection) - 2) {
      mode = 'video';
      lockScrollAt(sectionTop(videoSection));
    } else if (y < sectionTop(loopSection) + window.innerHeight) {
      mode = 'loop';
      lockScrollAt(sectionTop(loopSection));
    } else {
      mode = 'free';
      unlockScroll();
    }
  };

  initialiseModeFromPosition();

  if (reduced) {
    steps.forEach((step) => step.classList.add('active'));
    flowStage.dataset.step = '7';
    flowStage.classList.add('is-approved');
    if (reviewChip) reviewChip.textContent = 'Approved';
  } else {
    setLoopState(0);
  }
</script>
